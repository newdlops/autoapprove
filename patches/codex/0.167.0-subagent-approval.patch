+            "threadId":child.to_string(),"turnId":"turn","itemId":"file","startedAtMs":0,
+            "reason":null,"grantRoot":null}}),
+        serde_json::json!({"id":202,"method":"mcpServer/elicitation/request","params":{
+            "threadId":child.to_string(),"turnId":"turn","serverName":"fixture","mode":"form",
