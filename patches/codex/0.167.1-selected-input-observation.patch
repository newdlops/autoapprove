+//! Kernel-backed journal coordination. Holding this is not a migration grant.
+use base64::Engine;
+use codex_core::native_ownership::{BorrowedMigrationLock, borrow_migration_lock};
+use codex_protocol::ThreadId;
+use serde::Deserialize;
+use serde_json::{Value, json};
+use sha2::{Digest, Sha256};
+use std::collections::{BTreeMap, HashSet};
+use std::io;
+use std::os::fd::{AsRawFd, FromRawFd, OwnedFd};
+use std::os::unix::fs::MetadataExt;
+use std::path::Path;
+use std::sync::Arc;
+use tokio::net::UnixStream;
+use tokio::time::Instant;
+
+#[derive(Clone, Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub(crate) struct JournalLockRequest {
+    pub(crate) request_id: String,
+    pub(crate) revision: u64,
+    pub(crate) digest: String,
+}
+fn invalid() -> io::Error {
+    io::Error::new(
+        io::ErrorKind::InvalidData,
+        "Journal lock or prepared move identity changed",
+    )
+}
+fn uuid(value: &str) -> bool {
+    uuid::Uuid::parse_str(value).is_ok_and(|id| id.to_string() == value)
+}
+fn hash(value: &str) -> bool {
+    value.len() == 64
+        && value
+            .bytes()
+            .all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b))
+}
+fn canonical(value: &Value) -> Value {
+    match value {
+        Value::Object(map) => {
+            let sorted: BTreeMap<_, _> = map
+                .iter()
+                .map(|(key, value)| (key.clone(), canonical(value)))
+                .collect();
+            Value::Object(sorted.into_iter().collect())
+        }
+        Value::Array(values) => Value::Array(values.iter().map(canonical).collect()),
+        value => value.clone(),
+    }
+}
+fn string<'a>(value: &'a Value, path: &str) -> io::Result<&'a str> {
+    value
+        .pointer(path)
+        .and_then(Value::as_str)
+        .ok_or_else(invalid)
+}
+
+pub(crate) struct NativeJournalLock {
+    lock: Arc<BorrowedMigrationLock>,
+    stamp: JournalLockRequest,
+    role: &'static str,
+    record: Value,
+    payload: Value,
+}
+impl NativeJournalLock {
+    pub(crate) fn stamp(&self) -> JournalLockRequest {
+        self.stamp.clone()
+    }
+    pub(crate) fn verify_kernel(&self) -> io::Result<()> {
+        self.lock.verify()
+    }
+    pub(crate) fn acquire(
+        home: &Path,
+        descriptor: OwnedFd,
+        stamp: JournalLockRequest,
+        scope: &HashSet<ThreadId>,
+    ) -> io::Result<Self> {
+        let lock = Arc::new(borrow_migration_lock(home, descriptor)?);
+        Self::bind(lock, stamp, scope)
+    }
+    fn bind(
+        lock: Arc<BorrowedMigrationLock>,
+        stamp: JournalLockRequest,
+        scope: &HashSet<ThreadId>,
+    ) -> io::Result<Self> {
+        if !uuid(&stamp.request_id)
+            || stamp.revision == 0
+            || stamp.revision > i64::MAX as u64
+            || !hash(&stamp.digest)
+        {
+            return Err(invalid());
+        }
+        let record = lock.journal_record(&stamp.request_id)?;
+        let object = record.as_object().ok_or_else(invalid)?;
+        let expected_keys = [
+            "formatVersion",
+            "id",
+            "revision",
+            "homes",
+            "payload",
+            "terminal",
+            "digest",
+            "previousDigest",
+        ];
+        if object
+            .keys()
+            .any(|key| !expected_keys.contains(&key.as_str()))
+            || record["formatVersion"] != 1
+            || record["id"] != stamp.request_id
+            || record["revision"].as_u64() != Some(stamp.revision)
+            || record["terminal"] != false
+            || record["digest"] != stamp.digest
+        {
+            return Err(invalid());
+        }
+        if stamp.revision == 1 {
+            if object.contains_key("previousDigest") || object.len() != 7 {
+                return Err(invalid());
+            }
+        } else if object.len() != 8 || !record["previousDigest"].as_str().is_some_and(hash) {
+            return Err(invalid());
+        }
+        let mut body = record.clone();
+        body.as_object_mut().ok_or_else(invalid)?.remove("digest");
+        let digest = format!(
+            "{:x}",
+            Sha256::digest(serde_json::to_vec(&canonical(&body))?)
+        );
+        if digest != stamp.digest {
+            return Err(invalid());
+        }
+        let encoded = string(&record, "/payload")?;
+        if encoded.len() > 12 * 1024 * 1024 {
+            return Err(invalid());
+        }
+        let bytes = base64::engine::general_purpose::STANDARD
+            .decode(encoded)
+            .map_err(|_| invalid())?;
+        if bytes.len() > 8 * 1024 * 1024
+            || base64::engine::general_purpose::STANDARD.encode(&bytes) != encoded
+        {
+            return Err(invalid());
+        }
+        let payload: Value = serde_json::from_slice(&bytes)?;
+        if payload["formatVersion"] != 1
+            || payload["stage"] != "prepared"
+            || string(&payload, "/request/id")? != stamp.request_id
+        {
+            return Err(invalid());
+        }
+        let source = string(&payload, "/request/source/home")?;
+        let destination = string(&payload, "/request/destination/home")?;
+        let source_identity = string(&payload, "/request/source/physicalHomeID")?;
+        let destination_identity = string(&payload, "/request/destination/physicalHomeID")?;
+        if source == destination || source_identity == destination_identity {
+            return Err(invalid());
+        }
+        let mut homes = vec![
+            json!({"path":source,"identity":source_identity}),
+            json!({"path":destination,"identity":destination_identity}),
+        ];
+        homes.sort_by_key(|home| home["path"].as_str().unwrap_or("").to_owned());
+        if record["homes"] != json!(homes) {
+            return Err(invalid());
+        }
+        for (path, identity) in [
+            (source, source_identity),
+            (destination, destination_identity),
+        ] {
+            let actual = std::fs::canonicalize(path)?;
+            let info = std::fs::symlink_metadata(path)?;
+            if actual != Path::new(path)
+                || !info.is_dir()
+                || info.uid() != unsafe { libc::geteuid() }
+                || format!("{}:{}", info.dev(), info.ino()) != identity
+            {
+                return Err(invalid());
+            }
+        }
+        let role = if lock.home() == Path::new(source) && lock.home_identity() == source_identity {
+            "source"
+        } else if lock.home() == Path::new(destination)
+            && lock.home_identity() == destination_identity
+        {
+            "destination"
+        } else {
+            return Err(invalid());
+        };
+        let threads = payload
+            .pointer("/request/threads")
+            .and_then(Value::as_array)
+            .ok_or_else(invalid)?;
+        let names: HashSet<_> = scope.iter().map(ToString::to_string).collect();
+        let recorded: HashSet<_> = threads
+            .iter()
+            .map(|thread| string(thread, "/id").map(str::to_owned))
+            .collect::<io::Result<_>>()?;
+        if threads.len() != names.len()
+            || recorded != names
+            || threads.iter().any(|thread| thread["home"] != source)
+        {
+            return Err(invalid());
+        }
+        let owners = payload["currentOwners"].as_object().ok_or_else(invalid)?;
+        if owners.len() != names.len()
+            || names
+                .iter()
+                .any(|id| owners.get(id).and_then(Value::as_str) != Some(source))
+        {
+            return Err(invalid());
+        }
+        let clients = payload
+            .pointer("/request/clients")
+            .and_then(Value::as_array)
+            .ok_or_else(invalid)?;
+        if clients.is_empty() || clients.len() > 64 {
+            return Err(invalid());
+        }
+        let mut client_scope = HashSet::new();
+        for client in clients {
+            if client["home"] != source {
+                return Err(invalid());
+            }
+            let ids = client["threadIDs"].as_array().ok_or_else(invalid)?;
+            for id in ids {
+                client_scope.insert(id.as_str().ok_or_else(invalid)?.to_owned());
+            }
+        }
+        if client_scope != names {
+            return Err(invalid());
+        }
+        lock.verify()?;
+        Ok(Self {
+            lock,
+            stamp,
+            role,
+            record,
+            payload,
+        })
+    }
+    pub(crate) fn refresh(
+        &mut self,
+        stamp: JournalLockRequest,
+        scope: &HashSet<ThreadId>,
+    ) -> io::Result<()> {
+        if stamp.request_id != self.stamp.request_id
+            || self.stamp.revision.checked_add(1) != Some(stamp.revision)
+        {
+            return Err(invalid());
+        }
+        let next = Self::bind(Arc::clone(&self.lock), stamp, scope)?;
+        if next.record["previousDigest"] != self.stamp.digest
+            || next.role != self.role
+            || next.payload["request"] != self.payload["request"]
+        {
+            return Err(invalid());
+        }
+        *self = next;
+        Ok(())
+    }
+    pub(crate) fn require_phase(&self, phase: &str) -> io::Result<()> {
+        self.lock.verify()?;
+        if self.lock.journal_record(&self.stamp.request_id)? != self.record
+            || self
+                .payload
+                .pointer("/execution/phase")
+                .and_then(Value::as_str)
+                != Some(phase)
+        {
+            return Err(invalid());
+        }
+        Ok(())
+    }
+    pub(crate) fn require_source(&self) -> io::Result<()> {
+        if self.role != "source" {
+            return Err(invalid());
+        }
+        Ok(())
+    }
+    pub(crate) fn retain_kernel(&self) -> Arc<BorrowedMigrationLock> {
+        Arc::clone(&self.lock)
+    }
+    pub(crate) fn reply(&self, phase: &str) -> Value {
+        json!({"requestId":self.stamp.request_id,"revision":self.stamp.revision,"digest":self.stamp.digest,
+            "homeIdentity":self.lock.home_identity(),"role":self.role,"phase":phase,
+            "migrationAuthorized":false})
+    }
+}
+
+fn receive_now(fd: i32) -> io::Result<OwnedFd> {
+    let mut tag = 0u8;
+    let mut control = [0usize; 8];
+    let mut iov = libc::iovec {
+        iov_base: (&mut tag as *mut u8).cast(),
+        iov_len: 1,
+    };
+    let mut message: libc::msghdr = unsafe { std::mem::zeroed() };
+    message.msg_iov = &mut iov;
+    message.msg_iovlen = 1;
+    message.msg_control = control.as_mut_ptr().cast();
+    message.msg_controllen = std::mem::size_of_val(&control) as _;
+    let count = unsafe { libc::recvmsg(fd, &mut message, libc::MSG_DONTWAIT) };
+    if count < 0 {
+        return Err(io::Error::last_os_error());
+    }
+    let mut descriptors = Vec::new();
+    let mut valid = count == 1 && tag == 0x46 && message.msg_flags & libc::MSG_CTRUNC == 0;
+    let mut header = unsafe { libc::CMSG_FIRSTHDR(&message) };
+    while !header.is_null() {
+        let current = unsafe { &*header };
+        let base = unsafe { libc::CMSG_LEN(0) } as usize;
+        if current.cmsg_level != libc::SOL_SOCKET
+            || current.cmsg_type != libc::SCM_RIGHTS
+            || (current.cmsg_len as usize) < base
+            || current.cmsg_len > message.msg_controllen
+        {
+            valid = false;
+            break;
+        }
+        let bytes = current.cmsg_len as usize - base;
+        if bytes % std::mem::size_of::<i32>() != 0 {
+            valid = false;
+            break;
+        }
+        let data = unsafe { libc::CMSG_DATA(header) }.cast::<i32>();
+        for index in 0..bytes / std::mem::size_of::<i32>() {
+            let raw = unsafe { data.add(index).read_unaligned() };
+            if raw < 0 {
+                valid = false;
+                continue;
+            }
+            let descriptor = unsafe { OwnedFd::from_raw_fd(raw) };
+            let flags = unsafe { libc::fcntl(raw, libc::F_GETFD) };
+            if flags < 0
+                || unsafe { libc::fcntl(raw, libc::F_SETFD, flags | libc::FD_CLOEXEC) } != 0
+            {
+                valid = false;
+            }
+            descriptors.push(descriptor);
+        }
+        header = unsafe { libc::CMSG_NXTHDR(&message, header) };
+    }
+    if !valid || descriptors.len() != 1 {
+        return Err(invalid());
+    }
+    descriptors.pop().ok_or_else(invalid)
+}
+pub(crate) async fn receive(stream: &UnixStream, deadline: Instant) -> io::Result<OwnedFd> {
+    loop {
+        tokio::time::timeout_at(deadline, stream.readable())
+            .await
+            .map_err(|_| io::ErrorKind::TimedOut)??;
+        match stream.try_io(tokio::io::Interest::READABLE, || {
+            receive_now(stream.as_raw_fd())
+        }) {
+            Err(error) if error.kind() == io::ErrorKind::WouldBlock => continue,
+            result => return result,
+        }
+    }
+}
