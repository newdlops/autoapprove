+//! Opt-in local terminal input hold. Existing accepted work keeps running.
+//! No complete ownership, task-stop or migration authority is asserted.
+use crate::app_event::AppEvent;
+use crate::app_event_sender::AppEventSender;
+use serde::Deserialize;
+use serde_json::{Value, json};
+use std::io;
+use std::os::unix::fs::{MetadataExt, PermissionsExt};
+use std::path::PathBuf;
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::sync::{Arc, Mutex, Weak};
+use std::time::{Duration, Instant};
+use tokio::io::{AsyncBufReadExt, AsyncReadExt, AsyncWriteExt, BufReader};
+use tokio::net::{UnixListener, UnixStream};
+use tokio::sync::oneshot;
+use tokio::task::{JoinHandle, JoinSet};
+
+const TTL: Duration = Duration::from_secs(30);
+
+#[derive(Debug)]
+pub(crate) struct InputHold {
+    id: String,
+    deadline: Mutex<Instant>,
+    cancelled: AtomicBool,
+    installed: AtomicBool,
+}
+impl InputHold {
+    fn new(ttl: Duration) -> Self {
+        Self {
+            id: uuid::Uuid::now_v7().to_string(),
+            deadline: Mutex::new(Instant::now() + ttl),
+            cancelled: AtomicBool::new(false),
+            installed: AtomicBool::new(false),
+        }
+    }
+    pub(crate) fn install(&self) -> bool {
+        if !self.active() {
+            return false;
+        }
+        self.installed.store(true, Ordering::Release);
+        if !self.active() {
+            self.finish();
+            return false;
+        }
+        true
+    }
+    pub(crate) fn installed(&self) -> bool {
+        self.installed.load(Ordering::Acquire)
+    }
+    pub(crate) fn finish(&self) {
+        self.installed.store(false, Ordering::Release);
+    }
+    async fn uninstalled(&self) {
+        while self.installed() {
+            tokio::time::sleep(Duration::from_millis(10)).await;
+        }
+    }
+    pub(crate) fn active(&self) -> bool {
+        !self.cancelled.load(Ordering::Acquire)
+            && self
+                .deadline
+                .lock()
+                .is_ok_and(|deadline| Instant::now() < *deadline)
+    }
+    pub(crate) fn cancel(&self) {
+        self.cancelled.store(true, Ordering::Release);
+    }
+    pub(crate) async fn ended(&self) {
+        while self.active() {
+            tokio::time::sleep(Duration::from_millis(50)).await;
+        }
+    }
+    fn remaining(&self) -> Duration {
+        if self.cancelled.load(Ordering::Acquire) {
+            return Duration::ZERO;
+        }
+        self.deadline
+            .lock()
+            .map(|deadline| deadline.saturating_duration_since(Instant::now()))
+            .unwrap_or_default()
+    }
+    fn renew(&self, ttl: Duration) -> bool {
+        let Ok(mut deadline) = self.deadline.lock() else {
+            return false;
+        };
+        if self.cancelled.load(Ordering::Acquire) || Instant::now() >= *deadline {
+            return false;
+        }
+        *deadline = Instant::now() + ttl;
+        true
+    }
+}
+struct Owner(Arc<InputHold>);
+impl Drop for Owner {
+    fn drop(&mut self) {
+        self.0.cancel();
+    }
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields, rename_all = "camelCase")]
+struct Request {
+    op: String,
+    nonce: String,
+    generation: Option<String>,
+    lease_id: Option<String>,
+}
+
+pub(crate) struct InputHoldServer {
+    task: JoinHandle<()>,
+    path: PathBuf,
+    identity: (u64, u64),
+    active: Arc<Mutex<Weak<InputHold>>>,
+}
+impl Drop for InputHoldServer {
+    fn drop(&mut self) {
+        if let Ok(active) = self.active.lock()
+            && let Some(hold) = active.upgrade()
+        {
+            hold.cancel();
+        }
+        self.task.abort();
+        if let Ok(info) = std::fs::symlink_metadata(&self.path)
+            && (info.dev(), info.ino()) == self.identity
+        {
+            let _ = std::fs::remove_file(&self.path);
+        }
+    }
+}
+pub(crate) fn start(events: AppEventSender) -> io::Result<Option<InputHoldServer>> {
+    let Some(path) = std::env::var_os("AUTOAPPROVE_TUI_INPUT_HOLD_SOCKET") else {
+        return Ok(None);
+    };
+    start_at(PathBuf::from(path), events, TTL).map(Some)
+}
+fn start_at(path: PathBuf, events: AppEventSender, ttl: Duration) -> io::Result<InputHoldServer> {
+    let parent = path.parent().ok_or(io::ErrorKind::InvalidInput)?;
+    let info = std::fs::symlink_metadata(parent)?;
+    if !path.is_absolute()
+        || !info.is_dir()
+        || info.uid() != unsafe { libc::geteuid() }
+        || info.mode() & 0o077 != 0
+        || path.as_os_str().as_encoded_bytes().len() > 100
+    {
+        return Err(io::ErrorKind::PermissionDenied.into());
+    }
+    let listener = UnixListener::bind(&path)?;
+    let info = std::fs::symlink_metadata(&path)?;
+    let identity = (info.dev(), info.ino());
+    std::fs::set_permissions(&path, std::fs::Permissions::from_mode(0o600))?;
+    let generation = uuid::Uuid::now_v7().to_string();
+    let active = Arc::new(Mutex::new(Weak::<InputHold>::new()));
+    let server_active = active.clone();
+    let task = tokio::spawn(async move {
+        let mut sessions = JoinSet::new();
+        loop {
+            tokio::select! {
+                accepted = listener.accept() => {
+                    let Ok((stream, _)) = accepted else { break; };
+                    if sessions.len() >= 4 { continue; }
+                    let Ok(peer) = stream.peer_cred() else { continue; };
+                    if peer.uid() != unsafe { libc::geteuid() } { continue; }
+                    let (events, generation, active) = (events.clone(), generation.clone(), active.clone());
+                    sessions.spawn(async move { let _ = session(stream, events, generation, active, ttl).await; });
+                }
+                _ = sessions.join_next(), if !sessions.is_empty() => {}
+            }
+        }
+    });
+    Ok(InputHoldServer {
+        task,
+        path,
+        identity,
+        active: server_active,
+    })
+}
+async fn request(
+    reader: &mut BufReader<tokio::net::unix::OwnedReadHalf>,
+    timeout: Duration,
+) -> io::Result<Request> {
+    let mut line = String::new();
+    tokio::time::timeout(timeout, (&mut *reader).take(2049).read_line(&mut line))
+        .await
+        .map_err(|_| io::ErrorKind::TimedOut)??;
+    if line.len() > 2048 || !line.ends_with('\n') {
+        return Err(io::ErrorKind::InvalidInput.into());
+    }
+    let request: Request = serde_json::from_str(&line)?;
+    if request.nonce.len() != 32 || !request.nonce.bytes().all(|b| b.is_ascii_hexdigit()) {
+        return Err(io::ErrorKind::InvalidInput.into());
+    }
+    Ok(request)
+}
+async fn send(
+    writer: &mut tokio::net::unix::OwnedWriteHalf,
+    value: Value,
+    timeout: Duration,
+) -> io::Result<()> {
+    let mut bytes = serde_json::to_vec(&value)?;
+    if bytes.len() > 65536 {
+        return Err(io::ErrorKind::InvalidData.into());
+    }
+    bytes.push(b'\n');
+    tokio::time::timeout(
+        timeout.min(Duration::from_secs(2)),
+        writer.write_all(&bytes),
+    )
+    .await
+    .map_err(|_| io::ErrorKind::TimedOut)??;
+    Ok(())
+}
+fn response(request: &Request, generation: &str, owner: Option<&Owner>) -> Value {
+    let held = owner.is_some_and(|owner| owner.0.active());
+    json!({"schemaVersion":1,"producer":"autoapprove-native-tui-input-hold","pid":std::process::id(),
+        "nonce":request.nonce,"generation":generation,"leaseId":owner.map(|owner| &owner.0.id),
+        "leaseActive":held,"terminalInputBlocked":owner.is_some_and(|owner| owner.0.installed()),"leaseTTLMillis":owner.filter(|_| held).map(|owner| owner.0.remaining().as_millis() as u64).unwrap_or(0),
+        "acceptedWorkStopped":false,"membershipComplete":false,"migrationAuthorized":false})
+}
+
