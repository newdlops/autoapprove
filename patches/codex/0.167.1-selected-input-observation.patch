+//! Retain one shutdown submission per captured runtime. Observation deadlines
+//! and disconnected callers never cancel or resubmit that shutdown.
+use std::collections::HashMap;
+use std::future::Future;
+use std::hash::Hash;
+use std::sync::Arc;
+use std::time::Duration;
+use tokio::sync::{Mutex, watch};
+
+type Outcome = Result<(), String>;
+struct Entry<T> {
+    runtime: Arc<T>,
+    result: watch::Receiver<Option<Outcome>>,
+}
+
+pub(super) struct RetainedShutdowns<K, T> {
+    entries: Mutex<HashMap<K, Entry<T>>>,
+}
+
+impl<K, T> Default for RetainedShutdowns<K, T> {
+    fn default() -> Self {
+        Self {
+            entries: Mutex::new(HashMap::new()),
+        }
+    }
+}
+
+#[derive(Debug, PartialEq, Eq)]
+pub(super) enum Observation {
+    Stopped,
+    Pending,
+    Failed(String),
+}
+
+impl<K: Eq + Hash, T: Send + Sync + 'static> RetainedShutdowns<K, T> {
+    pub(super) async fn observe<F, Fut>(
+        &self,
+        id: K,
+        runtime: Arc<T>,
+        deadline: Duration,
+        shutdown: F,
+    ) -> Observation
+    where
+        F: FnOnce(Arc<T>) -> Fut + Send + 'static,
+        Fut: Future<Output = Outcome> + Send + 'static,
+    {
+        let mut result = {
+            let mut entries = self.entries.lock().await;
+            match entries.get(&id) {
+                Some(entry) if Arc::ptr_eq(&entry.runtime, &runtime) => entry.result.clone(),
+                _ => {
+                    let (sender, receiver) = watch::channel(None);
+                    entries.insert(
+                        id,
+                        Entry {
+                            runtime: Arc::clone(&runtime),
+                            result: receiver.clone(),
+                        },
+                    );
+                    // No await after publication: cancellation cannot leave an
+                    // entry without a task, or a task without its entry.
+                    tokio::spawn(async move {
+                        sender.send_replace(Some(shutdown(runtime).await));
+                    });
+                    receiver
+                }
+            }
+        };
+        let terminal = async {
+            loop {
+                if let Some(result) = result.borrow_and_update().clone() {
+                    return match result {
+                        Ok(()) => Observation::Stopped,
+                        Err(error) => Observation::Failed(error),
+                    };
+                }
+                if result.changed().await.is_err() {
+                    return Observation::Failed(
+                        "Shutdown task ended without a confirmed result".into(),
+                    );
+                }
+            }
+        };
+        tokio::time::timeout(deadline, terminal)
+            .await
+            .unwrap_or(Observation::Pending)
+    }
+
+    pub(super) async fn forget_if_matches(&self, id: &K, runtime: &Arc<T>) {
+        let mut entries = self.entries.lock().await;
+        if entries
+            .get(id)
+            .is_some_and(|entry| Arc::ptr_eq(&entry.runtime, runtime))
+        {
+            entries.remove(id);
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::sync::atomic::{AtomicUsize, Ordering};
+    use tokio::sync::Notify;
+
+    #[tokio::test]
+    async fn timeout_and_cancelled_observer_keep_one_live_submission() {
+        let registry = Arc::new(RetainedShutdowns::default());
+        let runtime = Arc::new(());
+        let started = Arc::new(AtomicUsize::new(0));
+        let finished = Arc::new(Notify::new());
+        let (r, t, s, f) = (
+            registry.clone(),
+            runtime.clone(),
+            started.clone(),
+            finished.clone(),
+        );
+        let observer = tokio::spawn(async move {
+            r.observe(1, t, Duration::from_secs(60), move |_| async move {
+                s.fetch_add(1, Ordering::SeqCst);
+                f.notified().await;
+                Ok(())
+            })
+            .await
+        });
+        while started.load(Ordering::SeqCst) == 0 {
+            tokio::task::yield_now().await;
+        }
+        observer.abort();
+        let _ = observer.await;
+        assert_eq!(
+            registry
+                .observe(1, runtime.clone(), Duration::from_millis(1), |_| async {
+                    panic!("a reconnect must observe, not submit shutdown again")
+                })
+                .await,
+            Observation::Pending
+        );
+        assert_eq!(started.load(Ordering::SeqCst), 1);
+        finished.notify_one();
+        assert_eq!(
+            registry
+                .observe(1, runtime, Duration::from_secs(1), |_| async {
+                    panic!("late completion must reuse the captured shutdown")
+                })
+                .await,
+            Observation::Stopped
+        );
+    }
+
+    #[tokio::test]
+    async fn submission_failure_is_terminal_and_never_replayed() {
+        let registry = RetainedShutdowns::default();
+        let runtime = Arc::new(());
+        assert_eq!(
+            registry
+                .observe(1, runtime.clone(), Duration::from_secs(1), |_| async {
+                    Err("submission rejected".into())
+                })
+                .await,
+            Observation::Failed("submission rejected".into())
+        );
+        assert_eq!(
+            registry
+                .observe(1, runtime, Duration::from_secs(1), |_| async {
+                    panic!("an unknown submission must not be replayed")
+                })
+                .await,
+            Observation::Failed("submission rejected".into())
+        );
+    }
+
+    #[tokio::test]
+    async fn old_cleanup_cannot_forget_replacement_runtime() {
+        let registry = RetainedShutdowns::default();
+        let old = Arc::new(());
+        let replacement = Arc::new(());
+        assert_eq!(
+            registry
+                .observe(1, old.clone(), Duration::from_secs(1), |_| async { Ok(()) })
+                .await,
+            Observation::Stopped
+        );
+        assert_eq!(
+            registry
+                .observe(1, replacement.clone(), Duration::from_secs(1), |_| async {
+                    Err("replacement failed".into())
+                })
+                .await,
+            Observation::Failed("replacement failed".into())
+        );
+        registry.forget_if_matches(&1, &old).await;
+        assert_eq!(
+            registry
+                .observe(1, replacement.clone(), Duration::from_secs(1), |_| async {
+                    panic!("old cleanup removed the replacement outcome")
+                })
+                .await,
+            Observation::Failed("replacement failed".into())
+        );
+        registry.forget_if_matches(&1, &replacement).await;
+        assert_eq!(
+            registry
+                .observe(1, replacement, Duration::from_secs(1), |_| async { Ok(()) })
+                .await,
+            Observation::Stopped
+        );
+    }
+}
