+        assert_eq!(after["byConnection"]["7"], json!([root.to_string()]));
+        assert_eq!(after["initializedConnectionIDs"], json!([2, 7]));
+        state.remove_connection(ConnectionId(7)).await;
+        let closed = state.native_inventory_snapshot().await;
+        assert_eq!(closed["initializedConnectionIDs"], json!([2]));
+        assert_eq!(closed["subscribers"][root.to_string()], json!([]));
+    }
