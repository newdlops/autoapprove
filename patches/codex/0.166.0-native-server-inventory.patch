+//! Kernel process-instance identity. Never infer it from initialize metadata.
+use serde::Serialize;
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct NativePeerIdentity {
+    pub source: &'static str,
+    pub pid: u32,
+    pub effective_uid: u32,
+    pub effective_gid: u32,
+    pub audit_pid_version: u32,
+}
+
+pub fn native_current_process_identity() -> Option<NativePeerIdentity> {
+    #[cfg(all(feature = "autoapprove-native-inventory", target_os = "macos"))]
+    {
+        apple::current()
+    }
+    #[cfg(not(all(feature = "autoapprove-native-inventory", target_os = "macos")))]
+    {
+        None
+    }
+}
+
+pub(crate) fn capture(stream: &codex_uds::UnixStream) -> Option<NativePeerIdentity> {
+    #[cfg(all(feature = "autoapprove-native-inventory", target_os = "macos"))]
+    {
+        use std::os::fd::AsRawFd;
+        apple::peer(stream.as_raw_fd())
+    }
+    #[cfg(not(all(feature = "autoapprove-native-inventory", target_os = "macos")))]
+    {
+        let _ = stream;
+        None
+    }
+}
+
+#[cfg(all(feature = "autoapprove-native-inventory", target_os = "macos"))]
+mod apple {
+    use super::NativePeerIdentity;
+
+    // The SDK declares this opaque 8-word token in mach/message.h. Interpret it
+    // only with libbsm accessors, not assumptions about word offsets.
+    #[repr(C)]
+    #[derive(Clone, Copy)]
+    struct AuditToken {
+        words: [u32; 8],
+    }
+
+    #[link(name = "bsm")]
+    unsafe extern "C" {
+        fn audit_token_to_euid(token: AuditToken) -> libc::uid_t;
+        fn audit_token_to_egid(token: AuditToken) -> libc::gid_t;
+        fn audit_token_to_pid(token: AuditToken) -> libc::pid_t;
+        fn audit_token_to_pidversion(token: AuditToken) -> libc::c_int;
+    }
+
+    fn identity(token: AuditToken) -> Option<NativePeerIdentity> {
+        let pid = unsafe { audit_token_to_pid(token) };
+        let version = unsafe { audit_token_to_pidversion(token) } as u32;
+        if pid <= 0 || version == 0 {
+            return None;
+        }
+        Some(NativePeerIdentity {
+            source: "macos-audit-token",
+            pid: pid as u32,
+            effective_uid: unsafe { audit_token_to_euid(token) },
+            effective_gid: unsafe { audit_token_to_egid(token) },
+            audit_pid_version: version,
+        })
+    }
+
+    pub(super) fn peer(fd: libc::c_int) -> Option<NativePeerIdentity> {
+        let mut token = AuditToken { words: [0; 8] };
+        let mut size = std::mem::size_of::<AuditToken>() as libc::socklen_t;
+        let status = unsafe {
+            libc::getsockopt(
+                fd,
+                libc::SOL_LOCAL,
+                libc::LOCAL_PEERTOKEN,
+                (&mut token as *mut AuditToken).cast(),
+                &mut size,
+            )
+        };
+        if status != 0 || size as usize != std::mem::size_of::<AuditToken>() {
+            return None;
+        }
+        identity(token)
+    }
+
+    pub(super) fn current() -> Option<NativePeerIdentity> {
+        // TASK_AUDIT_TOKEN and COUNT are defined as 15 and 8 by mach/task_info.h.
+        let mut token = AuditToken { words: [0; 8] };
+        let mut count: libc::mach_msg_type_number_t = 8;
+        let status = unsafe {
+            libc::task_info(
+                libc::mach_task_self(),
+                15,
+                (&mut token as *mut AuditToken).cast(),
+                &mut count,
+            )
+        };
+        if status != libc::KERN_SUCCESS || count != 8 {
+            return None;
+        }
+        let value = identity(token)?;
+        (value.pid == std::process::id()
+            && value.effective_uid == unsafe { libc::geteuid() }
+            && value.effective_gid == unsafe { libc::getegid() })
+        .then_some(value)
+    }
+}
