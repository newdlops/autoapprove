+//! Durable denial of writes to conversations retired from a login home.
+//! An absent policy directory preserves ordinary Codex behavior. A published
+//! directory with missing, linked or inconsistent contents fails closed.
+use serde::{Deserialize, Serialize};
+use std::collections::HashSet;
+use std::fs::{File, OpenOptions};
+use std::io::{self, Read};
+use std::os::fd::{AsRawFd, FromRawFd, OwnedFd};
+use std::os::unix::fs::{MetadataExt, OpenOptionsExt};
+use std::path::Path;
+
+pub const POLICY_DIRECTORY: &str = ".autoapprove-ownership";
+pub const REQUIRED_FILE: &str = "required.json";
+pub const STATE_FILE: &str = "state.json";
+pub mod store;
+
+/// Shares the exact home lock used by AutoApprove's migration journal. Holding
+/// this through manager publication prevents a new writer crossing reservation.
+pub struct StartupGuard {
+    home: std::path::PathBuf,
+    root: File,
+    directory: File,
+    lock: File,
+}
+
+/// An exclusive journal lock transferred as an OS descriptor. JSON cannot
+/// construct this witness, and dropping the sender does not release our copy.
+/// This is coordination only; it grants no writer or migration permission.
+pub struct BorrowedMigrationLock {
+    guard: StartupGuard,
+    identity: String,
+}
+impl BorrowedMigrationLock {
+    pub fn home_identity(&self) -> &str {
+        &self.identity
+    }
+    pub fn verify(&self) -> io::Result<()> {
+        self.guard.verify()
+    }
+    pub fn home(&self) -> &Path {
+        &self.guard.home
+    }
+    pub fn journal_record(&self, request_id: &str) -> io::Result<serde_json::Value> {
+        if !canonical_uuid(request_id) {
+            return Err(unavailable());
+        }
+        self.verify()?;
+        let active: serde_json::Value =
+            read(&self.guard.directory, "active.json", 12 * 1024 * 1024)?;
+        let history: serde_json::Value = read(
+            &self.guard.directory,
+            &format!("{request_id}.json"),
+            12 * 1024 * 1024,
+        )?;
+        self.verify()?;
+        if active != history {
+            return Err(unavailable());
+        }
+        Ok(active)
+    }
+}
+pub fn borrow_migration_lock(
+    home: &Path,
+    descriptor: OwnedFd,
+) -> io::Result<BorrowedMigrationLock> {
+    let (home, root, identity) = open_home(home)?;
+    let directory = open_at(
+        &root,
+        ".autoapprove-migrations",
+        libc::O_RDONLY | libc::O_DIRECTORY,
+        0,
+    )?;
+    let lock = File::from(descriptor);
+    let current = open_at(&directory, "lock", libc::O_RDONLY, 0)?;
+    let a = lock.metadata()?;
+    let b = current.metadata()?;
+    if !private(&directory.metadata()?, true)
+        || !private(&a, false)
+        || !private(&b, false)
+        || (a.dev(), a.ino()) != (b.dev(), b.ino())
+        || unsafe { libc::fcntl(lock.as_raw_fd(), libc::F_GETFL) } & libc::O_ACCMODE != libc::O_RDWR
+    {
+        return Err(unavailable());
+    }
+    let flags = unsafe { libc::fcntl(lock.as_raw_fd(), libc::F_GETFD) };
+    if flags < 0
+        || unsafe { libc::fcntl(lock.as_raw_fd(), libc::F_SETFD, flags | libc::FD_CLOEXEC) } != 0
+        || unsafe { libc::flock(lock.as_raw_fd(), libc::LOCK_EX | libc::LOCK_NB) } != 0
+    {
+        return Err(unavailable());
+    }
+    let guard = StartupGuard {
+        home,
+        root,
+        directory,
+        lock,
+    };
+    guard.verify()?;
+    Ok(BorrowedMigrationLock { guard, identity })
+}
+fn open_at(parent: &File, name: &str, flags: i32, mode: u32) -> io::Result<File> {
+    let name = std::ffi::CString::new(name).map_err(|_| unavailable())?;
+    let fd = unsafe {
+        libc::openat(
+            parent.as_raw_fd(),
+            name.as_ptr(),
+            flags | libc::O_NOFOLLOW | libc::O_CLOEXEC | libc::O_NONBLOCK,
+            mode as libc::c_uint,
+        )
+    };
+    if fd < 0 {
+        Err(unavailable())
+    } else {
+        Ok(unsafe { File::from_raw_fd(fd) })
+    }
+}
+fn private(info: &std::fs::Metadata, directory: bool) -> bool {
+    info.uid() == unsafe { libc::geteuid() }
+        && info.mode() & 0o077 == 0
+        && if directory {
+            info.is_dir()
+        } else {
+            info.is_file() && info.nlink() == 1
+        }
+}
+impl StartupGuard {
+    pub fn verify(&self) -> io::Result<()> {
+        let root = self.root.metadata().map_err(|_| unavailable())?;
+        let path = std::fs::symlink_metadata(&self.home).map_err(|_| unavailable())?;
+        if !path.is_dir() || (path.dev(), path.ino()) != (root.dev(), root.ino()) {
+            return Err(unavailable());
+        }
+        let current_dir = open_at(
+            &self.root,
+            ".autoapprove-migrations",
+            libc::O_RDONLY | libc::O_DIRECTORY,
+            0,
+        )?;
+        let dir = self.directory.metadata().map_err(|_| unavailable())?;
+        let current = current_dir.metadata().map_err(|_| unavailable())?;
+        if !private(&current, true) || (current.dev(), current.ino()) != (dir.dev(), dir.ino()) {
+            return Err(unavailable());
+        }
+        let current_lock = open_at(&current_dir, "lock", libc::O_RDONLY, 0)?;
+        let lock = self.lock.metadata().map_err(|_| unavailable())?;
+        let current = current_lock.metadata().map_err(|_| unavailable())?;
+        if !private(&current, false) || (current.dev(), current.ino()) != (lock.dev(), lock.ino()) {
+            return Err(unavailable());
+        }
+        Ok(())
+    }
+}
+pub fn startup_guard(home: &Path) -> io::Result<Option<StartupGuard>> {
+    startup_guard_enabled(home, cfg!(feature = "autoapprove-native-ownership"))
+}
+fn startup_guard_enabled(home: &Path, enabled: bool) -> io::Result<Option<StartupGuard>> {
+    if !enabled && !present(&home.join(POLICY_DIRECTORY))? {
+        return Ok(None);
+    }
+    let home = home.canonicalize().map_err(|_| unavailable())?;
+    let root = OpenOptions::new()
+        .read(true)
+        .custom_flags(libc::O_DIRECTORY | libc::O_NOFOLLOW | libc::O_CLOEXEC)
+        .open(&home)
+        .map_err(|_| unavailable())?;
+    let info = root.metadata().map_err(|_| unavailable())?;
+    if !info.is_dir() || info.uid() != unsafe { libc::geteuid() } {
+        return Err(unavailable());
+    }
+    let name = c".autoapprove-migrations";
+    if unsafe { libc::mkdirat(root.as_raw_fd(), name.as_ptr(), 0o700) } != 0
+        && io::Error::last_os_error().kind() != io::ErrorKind::AlreadyExists
+    {
+        return Err(unavailable());
+    }
+    let directory = open_at(
+        &root,
+        ".autoapprove-migrations",
+        libc::O_RDONLY | libc::O_DIRECTORY,
+        0,
+    )?;
+    if !private(&directory.metadata().map_err(|_| unavailable())?, true) {
+        return Err(unavailable());
+    }
+    let lock = open_at(&directory, "lock", libc::O_RDWR | libc::O_CREAT, 0o600)?;
+    if !private(&lock.metadata().map_err(|_| unavailable())?, false) {
+        return Err(unavailable());
+    }
+    if unsafe { libc::flock(lock.as_raw_fd(), libc::LOCK_SH | libc::LOCK_NB) } != 0 {
+        return Err(io::Error::new(
+            io::ErrorKind::WouldBlock,
+            "A conversation connection is preparing to move; retry after the move",
+        ));
+    }
+    let guard = StartupGuard {
+        home,
+        root,
+        directory,
+        lock,
+    };
+    guard.verify()?;
+    Ok(Some(guard))
+}
+
+#[derive(Clone, Debug, Deserialize, Serialize, PartialEq, Eq)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+struct Required {
+    schema_version: u32,
+    home_identity: String,
+}
+#[derive(Clone, Debug, Deserialize, Serialize, PartialEq, Eq)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+struct State {
+    schema_version: u32,
+    home_identity: String,
+    revision: u64,
+    threads: Vec<Thread>,
+}
+#[derive(Clone, Debug, Deserialize, Serialize, PartialEq, Eq)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+struct Thread {
+    thread_id: String,
+    request_id: String,
+    owner_home_identity: String,
+    phase: Phase,
+}
+#[derive(Clone, Debug, Deserialize, Serialize, PartialEq, Eq)]
+#[serde(rename_all = "kebab-case")]
+enum Phase {
+    Active,
+    Incoming,
+    Retired,
+}
+fn unavailable() -> io::Error {
+    io::Error::new(
+        io::ErrorKind::InvalidData,
+        "Conversation ownership could not be verified; review the move in AutoApprove",
+    )
+}
+fn canonical_uuid(value: &str) -> bool {
+    uuid::Uuid::parse_str(value).is_ok_and(|id| id.to_string() == value)
+}
+fn identity(value: &str) -> bool {
+    let Some((device, inode)) = value.split_once(':') else {
+        return false;
+    };
+    [device, inode].iter().all(|part| {
+        part.parse::<u64>()
+            .is_ok_and(|number| number.to_string() == *part)
+    })
+}
+fn present(path: &Path) -> io::Result<bool> {
+    match std::fs::symlink_metadata(path) {
+        Ok(_) => Ok(true),
+        Err(error) if error.kind() == io::ErrorKind::NotFound => Ok(false),
+        Err(_) => Err(unavailable()),
+    }
+}
+fn read<T: for<'de> Deserialize<'de>>(root: &File, name: &str, limit: u64) -> io::Result<T> {
+    let name = std::ffi::CString::new(name).map_err(|_| unavailable())?;
+    let fd = unsafe {
+        libc::openat(
+            root.as_raw_fd(),
+            name.as_ptr(),
+            libc::O_RDONLY | libc::O_NOFOLLOW | libc::O_NONBLOCK | libc::O_CLOEXEC,
+        )
+    };
+    if fd < 0 {
+        return Err(unavailable());
+    }
+    let mut file = unsafe { File::from_raw_fd(fd) };
+    let before = file.metadata().map_err(|_| unavailable())?;
+    if !before.is_file()
+        || before.uid() != unsafe { libc::geteuid() }
+        || before.mode() & 0o077 != 0
+        || before.nlink() != 1
+        || before.len() == 0
+        || before.len() > limit
+    {
+        return Err(unavailable());
+    }
+    let mut data = Vec::new();
+    (&mut file)
+        .take(limit + 1)
+        .read_to_end(&mut data)
+        .map_err(|_| unavailable())?;
+    let after = file.metadata().map_err(|_| unavailable())?;
+    if data.len() as u64 != before.len()
+        || before.len() != after.len()
+        || before.mtime() != after.mtime()
+        || before.mtime_nsec() != after.mtime_nsec()
+        || before.ctime() != after.ctime()
+        || before.ctime_nsec() != after.ctime_nsec()
+    {
+        return Err(unavailable());
+    }
+    serde_json::from_slice(&data).map_err(|_| unavailable())
+}
+
+/// Checks both resume and turn submission. This is not a retirement witness or
+/// migration grant: native quiescence and the transition journal are still required.
+struct Loaded {
+    physical: std::path::PathBuf,
+    root: File,
+    policy: File,
+    state: State,
+}
+fn open_home(home: &Path) -> io::Result<(std::path::PathBuf, File, String)> {
+    let physical = home.canonicalize().map_err(|_| unavailable())?;
+    let root = OpenOptions::new()
+        .read(true)
+        .custom_flags(libc::O_DIRECTORY | libc::O_NOFOLLOW | libc::O_CLOEXEC)
+        .open(&physical)
+        .map_err(|_| unavailable())?;
+    let info = root.metadata().map_err(|_| unavailable())?;
+    if !info.is_dir() || info.uid() != unsafe { libc::geteuid() } {
+        return Err(unavailable());
+    }
+    let home_identity = format!("{}:{}", info.dev(), info.ino());
+    Ok((physical, root, home_identity))
+}
+fn load(home: &Path) -> io::Result<Option<Loaded>> {
+    if !present(&home.join(POLICY_DIRECTORY))? {
+        return Ok(None);
+    }
+    let (physical, root, home_identity) = open_home(home)?;
+    let policy = open_at(
+        &root,
+        POLICY_DIRECTORY,
+        libc::O_RDONLY | libc::O_DIRECTORY,
+        0,
+    )?;
+    if !private(&policy.metadata().map_err(|_| unavailable())?, true) {
+        return Err(unavailable());
+    }
+    let required: Required = read(&policy, REQUIRED_FILE, 4096)?;
+    let state: State = read(&policy, STATE_FILE, 16 * 1024 * 1024)?;
+    if required.schema_version != 1
+        || state.schema_version != 1
+        || state.revision == 0
+        || required.home_identity != home_identity
+        || state.home_identity != home_identity
+        || state.threads.len() > 65_536
+    {
+        return Err(unavailable());
+    }
+    let mut seen = HashSet::new();
+    for row in &state.threads {
+        if !canonical_uuid(&row.thread_id)
+            || !canonical_uuid(&row.request_id)
+            || !seen.insert(row.thread_id.clone())
+            || !identity(&row.owner_home_identity)
+            || (row.phase == Phase::Retired) == (row.owner_home_identity == home_identity)
+        {
+            return Err(unavailable());
+        }
+    }
+    let loaded = Loaded {
+        physical,
+        root,
+        policy,
+        state,
+    };
+    loaded.verify()?;
+    Ok(Some(loaded))
+}
+impl Loaded {
+    fn verify(&self) -> io::Result<()> {
+        let before = self.root.metadata().map_err(|_| unavailable())?;
+        let current = std::fs::symlink_metadata(&self.physical).map_err(|_| unavailable())?;
+        if !current.is_dir() || (current.dev(), current.ino()) != (before.dev(), before.ino()) {
+            return Err(unavailable());
+        }
+        let actual = open_at(
+            &self.root,
+            POLICY_DIRECTORY,
+            libc::O_RDONLY | libc::O_DIRECTORY,
+            0,
+        )?;
+        let before = self.policy.metadata().map_err(|_| unavailable())?;
+        let current = actual.metadata().map_err(|_| unavailable())?;
+        if !private(&current, true)
+            || (current.dev(), current.ino()) != (before.dev(), before.ino())
+        {
+            return Err(unavailable());
+        }
+        Ok(())
+    }
+}
+pub fn check_writer(home: &Path, thread_id: &str) -> io::Result<()> {
+    if !canonical_uuid(thread_id) {
+        return Err(unavailable());
+    }
+    let Some(loaded) = load(home)? else {
+        return Ok(());
+    };
+    let allowed = loaded
+        .state
+        .threads
+        .iter()
+        .find(|row| row.thread_id == thread_id)
+        .is_none_or(|row| row.phase == Phase::Active);
+    if allowed {
+        Ok(())
+    } else {
+        Err(io::Error::new(
+            io::ErrorKind::PermissionDenied,
+            "Conversation is moving or belongs to another login group; reconnect through AutoApprove",
+        ))
+    }
+}
