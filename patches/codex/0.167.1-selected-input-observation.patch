+#[tokio::test]
+async fn selected_native_control_requires_its_own_live_exact_drained_guard() {
+    let gate = TurnAdmission::default();
+    let other_server = TurnAdmission::default();
+    let selected = ThreadId::new();
+    let unrelated = ThreadId::new();
+    let ids = HashSet::from([selected]);
+    let hold = gate.pause_selected(ids.clone()).await.unwrap();
+    assert!(hold.verify_scope(&gate, &ids).is_ok());
+    assert!(hold.verify_scope(&other_server, &ids).is_err());
+    assert!(
+        hold.verify_scope(&gate, &HashSet::from([unrelated]))
+            .is_err()
+    );
+    assert!(
+        hold.verify_scope(&gate, &HashSet::from([selected, unrelated]))
+            .is_err()
+    );
+    let unrelated_input = gate.admit_thread_input(unrelated).unwrap();
+    assert!(hold.verify_scope(&gate, &ids).is_ok());
+    drop(unrelated_input);
+    gate.begin_drain();
+    assert!(hold.verify_scope(&gate, &ids).is_err());
+}
+
+#[tokio::test]
+async fn selected_hold_blocks_only_selected_input_and_preserves_global_drain() {
+    let gate = TurnAdmission::default();
+    let selected = ThreadId::new();
+    let other = ThreadId::new();
+    let hold = gate
+        .pause_selected(HashSet::from([selected]))
+        .await
+        .unwrap();
+    assert!(gate.admit_selected_scope(Some(selected)).is_err());
+    assert!(gate.admit_thread_input(selected).is_none());
+    assert!(gate.admit_selected_scope(None).is_err());
+    drop(gate.admit_selected_scope(Some(other)).unwrap());
+    drop(gate.admit_thread_input(other).unwrap());
+    assert!(gate.pause().await.is_err());
+    assert!(gate.pause_selected(HashSet::from([other])).await.is_err());
+    gate.begin_drain();
+    drop(hold);
+    assert!(gate.admit().is_err());
+    assert!(
+        gate.pause_selected(HashSet::from([selected]))
+            .await
+            .is_err()
+    );
+}
+
+#[tokio::test]
+async fn selected_hold_drains_accepted_rpc_before_closing_core_input() {
+    let gate = TurnAdmission::default();
+    let selected = ThreadId::new();
+    let other = ThreadId::new();
+    let rpc = gate.admit_selected_scope(Some(selected)).unwrap();
+    let unrelated_rpc = gate.admit_selected_scope(Some(other)).unwrap();
+    let unrelated_input = gate.admit_thread_input(other).unwrap();
+    let pending = gate.pause_selected(HashSet::from([selected]));
+    tokio::pin!(pending);
+    tokio::select! {
+        biased;
+        _ = &mut pending => panic!("accepted RPC must drain"),
+        () = async {} => {}
+    }
+    assert!(gate.admit_selected_scope(Some(selected)).is_err());
+    // Already accepted RPC still delivers its queued input; it is not dropped
+    // by a second admission check inside Core while the RPC drains.
+    let input = gate.admit_thread_input(selected).unwrap();
+    drop(rpc);
+    tokio::select! {
+        biased;
+        _ = &mut pending => panic!("Core submission must drain"),
+        () = async {} => {}
+    }
+    assert!(gate.admit_thread_input(selected).is_none());
+    drop(input);
+    let hold = pending.await.unwrap();
+    // Holding another conversation's permits did not delay acknowledgement.
+    drop((unrelated_rpc, unrelated_input));
+    drop(hold);
+    drop(gate.admit_thread_input(selected).unwrap());
+}
