+//! Local diagnostic observation, never a census-completeness or migration grant.
+use crate::message_processor::MessageProcessor;
+use crate::transport::ConnectionId;
+use crate::transport::ConnectionState;
+use serde_json::Value;
+use serde_json::json;
+use std::collections::HashMap;
+use std::io;
+use std::time::Duration;
+use tokio::sync::mpsc;
+use tokio::sync::oneshot;
+
+pub(crate) struct InventoryRead {
+    pub(crate) nonce: String,
+    pub(crate) reply: oneshot::Sender<Value>,
+}
+
+#[cfg(all(feature = "autoapprove-native-inventory", unix))]
+#[path = "native_inventory_transport.rs"]
+mod transport;
+#[cfg(all(feature = "autoapprove-native-inventory", unix))]
+pub(crate) use transport::InventoryServer;
+#[cfg(not(all(feature = "autoapprove-native-inventory", unix)))]
+pub(crate) struct InventoryServer;
+
+pub(crate) fn start(events: mpsc::Sender<InventoryRead>) -> io::Result<Option<InventoryServer>> {
+    #[cfg(all(feature = "autoapprove-native-inventory", unix))]
+    {
+        transport::start(events)
+    }
+    #[cfg(not(all(feature = "autoapprove-native-inventory", unix)))]
+    {
+        drop(events);
+        Ok(None)
+    }
+}
+
+fn connection_rows(connections: &HashMap<ConnectionId, ConnectionState>) -> Vec<Value> {
+    let mut rows: Vec<_> = connections.iter().collect();
+    rows.sort_by_key(|(id, _)| id.0);
+    rows.into_iter()
+        .map(|(id, connection)| {
+            json!({
+                "connectionID":id.0,
+                "origin":format!("{:?}",connection.origin),
+                "initialized":connection.session.initialized(),
+                "untrustedClientName":connection.session.app_server_client_name(),
+                "untrustedClientVersion":connection.session.client_version(),
+                "nativePeerIdentified":false,
+                "clientInventoryBound":false
+            })
+        })
+        .collect()
+}
+
+pub(crate) async fn snapshot(
+    nonce: String,
+    generation: &str,
+    connections: &HashMap<ConnectionId, ConnectionState>,
+    processor: &MessageProcessor,
+) -> Value {
+    // Keep a diagnostic from holding the transport loop behind a contended
+    // subscription lock. Neither the two stores nor pending transport events
+    // are revision-bound yet, so this must never authorize effects.
+    let subscriptions = tokio::time::timeout(
+        Duration::from_millis(100),
+        processor.native_inventory_subscriptions(),
+    )
+    .await;
+    let (subscriptions, error) = match subscriptions {
+        Ok(value) => (value, None),
+        Err(_) => (Value::Null, Some("subscription-snapshot-timeout")),
+    };
+    json!({
+        "schemaVersion":1,
+        "producer":"autoapprove-native-server-prototype",
+        "upstreamCommit":"6ff1e1ca3b30fc8b914720681fcf5fe62e95f856",
+        "cliVersion":env!("CARGO_PKG_VERSION"),
+        "pid":std::process::id(),
+        "serverGeneration":generation,
+        "nonce":nonce,
+        "connections":connection_rows(connections),
+        "subscriptions":subscriptions,
+        "error":error,
+        "consistentRevision":false,
+        "membershipComplete":false,
+        "admissionGranted":false,
+        "limitations":[
+            "native-peer-identity-required",
+            "client-inventory-binding-required",
+            "pending-transport-and-subscriber-revision-required",
+            "native-admission-and-backend-attestation-required"
+        ]
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::thread_state::ConnectionCapabilities;
+    use crate::thread_state::ThreadStateManager;
+    use crate::transport::ConnectionOrigin;
+    use codex_protocol::ThreadId;
+    use std::collections::HashSet;
+    use std::sync::Arc;
+    use std::sync::RwLock;
+    use std::sync::atomic::AtomicBool;
+
+    #[test]
+    fn uninitialized_transport_connection_is_not_omitted_or_attested() {
+        let connection = ConnectionState::new(
+            ConnectionOrigin::WebSocket,
+            None,
+            Arc::new(AtomicBool::new(false)),
+            Arc::new(AtomicBool::new(false)),
+            Arc::new(RwLock::new(HashSet::new())),
+        );
+        let rows = connection_rows(&HashMap::from([(ConnectionId(8), connection)]));
+        assert_eq!(rows.len(), 1);
+        assert_eq!(rows[0]["connectionID"], 8);
+        assert_eq!(rows[0]["initialized"], false);
+        assert_eq!(rows[0]["untrustedClientName"], Value::Null);
+        assert_eq!(rows[0]["nativePeerIdentified"], false);
+        assert_eq!(rows[0]["clientInventoryBound"], false);
+    }
+
+    #[tokio::test]
+    async fn actual_shared_subscription_store_changes_without_read_mutation() {
+        let state = ThreadStateManager::new();
+        let root = ThreadId::new();
+        for id in [ConnectionId(2), ConnectionId(7)] {
+            state
+                .connection_initialized(id, ConnectionCapabilities::default())
+                .await;
+            assert!(state.try_add_connection_to_thread(root, id).await);
+        }
+        let before = state.native_inventory_snapshot().await;
+        assert_eq!(before["subscribers"][root.to_string()], json!([2, 7]));
+        assert_eq!(state.native_inventory_snapshot().await, before);
+        assert!(
+            state
+                .unsubscribe_connection_from_thread(root, ConnectionId(2))
+                .await
+        );
+        let after = state.native_inventory_snapshot().await;
+        assert_eq!(after["subscribers"][root.to_string()], json!([7]));
+        assert!(after["byConnection"].get("2").is_none());
+        assert_eq!(after["byConnection"]["7"], json!([root.to_string()]));
+        assert_eq!(after["initializedConnectionIDs"], json!([2, 7]));
+        state.remove_connection(ConnectionId(7)).await;
+        let closed = state.native_inventory_snapshot().await;
+        assert_eq!(closed["initializedConnectionIDs"], json!([2]));
+        assert_eq!(closed["subscribers"][root.to_string()], json!([]));
+    }
+}
