+impl SelectedAdmissionPause {
+    /// Bind native control to this exact live guard, rather than trusting a
+    /// caller's copy of the selected IDs or another server's admission state.
+    pub(crate) fn verify_scope(
+        &self,
+        admission: &TurnAdmission,
+        threads: &HashSet<ThreadId>,
+    ) -> Result<(), JSONRPCErrorError> {
+        if !Arc::ptr_eq(&self.0.state, &admission.state) {
+            return Err(invalid_request(
+                "Selected input lease belongs to another server",
+            ));
+        }
+        let state = self
+            .0
+            .state
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        if state.closed
+            || state.paused
+            || !state.selected_inputs_closed
+            || state.selected.as_ref() != Some(threads)
+            || state.unscoped_active != 0
+            || threads.iter().any(|id| {
+                state.selected_active.contains_key(id) || state.selected_inputs.contains_key(id)
+            })
+        {
+            return Err(invalid_request(
+                "Selected input lease is no longer drained for the exact scope",
+            ));
+        }
+        Ok(())
+    }
+}
+
+impl Drop for SelectedAdmissionPause {
+    fn drop(&mut self) {
+        let mut state = self
+            .0
+            .state
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        state.selected = None;
+        state.selected_inputs_closed = false;
+    }
+}
+
+impl Drop for SelectedAdmissionPermit {
+    fn drop(&mut self) {
+        let mut state = self
+            .admission
+            .state
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        if let Some(id) = self.thread {
+            let counts = if self.input {
+                &mut state.selected_inputs
+            } else {
+                &mut state.selected_active
+            };
+            let count = counts.get_mut(&id).expect("owned admission permit");
+            *count -= 1;
+            if *count == 0 {
+                counts.remove(&id);
+            }
+        } else {
+            state.unscoped_active -= 1;
+        }
+        self.admission
+            .selected_revision_tx
+            .send_modify(|revision| *revision = revision.wrapping_add(1));
+    }
 }
 
