+//! Stop only captured selected runtimes. This task never archives or publishes
+//! ownership. Its caller retains input and kernel journal guards until terminal.
+use super::*;
+use crate::turn_admission::{SelectedAdmissionPause, TurnAdmission};
+use codex_core::ThreadRegistration;
+
+impl ThreadRequestProcessor {
+    pub(crate) async fn native_shutdown_selected(
+        &self,
+        admission: &TurnAdmission,
+        pause: &SelectedAdmissionPause,
+        ids: &HashSet<ThreadId>,
+    ) -> Result<(), JSONRPCErrorError> {
+        pause.verify_scope(admission, ids)?;
+        let mut names: Vec<_> = ids.iter().copied().collect();
+        names.sort_by_key(ToString::to_string);
+        let mut captured = Vec::new();
+        for id in &names {
+            if let Some(thread) = self
+                .thread_manager
+                .capture_thread_for_client_removal(id)
+                .await
+                .map_err(|error| core_thread_write_error("prepare move shutdown", error))?
+            {
+                captured.push((*id, thread));
+            }
+        }
+        // Empty persistent sessions must remain resumable under their original
+        // UUID. Finish materializing all of them before submitting shutdown.
+        for (id, _) in &captured {
+            self.thread_store
+                .persist_thread(*id, PersistContext::Standard)
+                .await
+                .map_err(|error| thread_store_mutation_error("prepare move shutdown", error))?;
+        }
+        for (id, thread) in &captured {
+            loop {
+                match self
+                    .retained_removal_shutdowns
+                    .observe(
+                        *id,
+                        Arc::clone(thread),
+                        Duration::from_secs(10),
+                        |thread| async move {
+                            thread
+                                .shutdown_and_wait()
+                                .await
+                                .map_err(|error| error.to_string())
+                        },
+                    )
+                    .await
+                {
+                    retained_shutdown::Observation::Stopped => break,
+                    retained_shutdown::Observation::Pending => continue,
+                    retained_shutdown::Observation::Failed(_) => {
+                        return Err(internal_error(format!(
+                            "Shutdown of selected conversation {id} was not confirmed"
+                        )));
+                    }
+                }
+            }
+        }
+        // No replacement may be torn down. The retained exclusive home lock
+        // prevents a reviewed Core startup crossing this entire operation.
+        for (id, thread) in &captured {
+            let _resume = self.thread_state_manager.lock_goal_resume(*id).await;
+            match self.thread_manager.thread_registration(*id, thread).await {
+                ThreadRegistration::Current => {
+                    if self
+                        .thread_manager
+                        .remove_thread_if_matches(id, thread)
+                        .await
+                        .is_none()
+                    {
+                        return Err(internal_error("Selected runtime changed during teardown"));
+                    }
+                }
+                ThreadRegistration::Absent => {}
+                ThreadRegistration::Replaced => {
+                    return Err(internal_error(
+                        "Selected runtime was replaced during shutdown",
+                    ));
+                }
+            }
+            self.finalize_thread_teardown(*id).await;
+            self.retained_removal_shutdowns
+                .forget_if_matches(id, thread)
+                .await;
+        }
+        for id in &names {
+            if self
+                .thread_manager
+                .capture_thread_for_client_removal(id)
+                .await
+                .map_err(|error| core_thread_write_error("verify move shutdown", error))?
+                .is_some()
+            {
+                return Err(internal_error(
+                    "Selected conversation still has a registered runtime",
+                ));
+            }
+        }
+        pause.verify_scope(admission, ids)?;
+        Ok(())
+    }
+}
