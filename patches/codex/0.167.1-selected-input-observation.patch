+//! Optional local selected-input lease. Does not attest client ownership or
+//! authorize migration. Enabled only by an explicit feature and local socket path.
+use crate::message_processor::NativeSelectedRuntime;
+use crate::turn_admission::TurnAdmission;
+use codex_protocol::ThreadId;
+use serde::Deserialize;
+use serde_json::{Value, json};
+use std::collections::HashSet;
+use std::io;
+use std::os::unix::fs::{MetadataExt, PermissionsExt};
+use std::path::PathBuf;
+use std::sync::Arc;
+use std::time::Duration;
+use tokio::io::{AsyncBufReadExt, AsyncRead, AsyncReadExt, AsyncWrite, AsyncWriteExt, BufReader};
+use tokio::net::{UnixListener, UnixStream};
+use tokio::task::{JoinHandle, JoinSet};
+use tokio::time::Instant;
+
+const TTL: Duration = Duration::from_secs(30);
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields, rename_all = "camelCase")]
+struct Request {
+    op: String,
+    nonce: String,
+    server_generation: Option<String>,
+    lease_id: Option<String>,
+    thread_ids: Option<Vec<String>>,
+    journal: Option<crate::selected_journal_lock::JournalLockRequest>,
+}
+
+pub(crate) struct SelectedTransitionServer {
+    task: JoinHandle<()>,
+    path: PathBuf,
+    identity: (u64, u64),
+}
+
+impl Drop for SelectedTransitionServer {
+    fn drop(&mut self) {
+        // The accept task owns its JoinSet; aborting it releases every lease.
+        self.task.abort();
+        if let Ok(info) = std::fs::symlink_metadata(&self.path)
+            && (info.dev(), info.ino()) == self.identity
+        {
+            let _ = std::fs::remove_file(&self.path);
+        }
+    }
+}
+
+pub(crate) fn start(
+    runtime: NativeSelectedRuntime,
+    recovery: Option<tokio::task::AbortHandle>,
+    fallback: Option<PathBuf>,
+) -> io::Result<Option<SelectedTransitionServer>> {
+    let Some(path) = std::env::var_os("AUTOAPPROVE_SELECTED_TRANSITION_SOCKET")
+        .map(PathBuf::from)
+        .or(fallback)
+    else {
+        return Ok(None);
+    };
+    let admission = runtime.admission();
+    start_with_recovery(path, admission, TTL, recovery, Some(runtime)).map(Some)
+}
+
+#[cfg(test)]
+fn start_at(
+    path: PathBuf,
+    admission: TurnAdmission,
+    ttl: Duration,
+) -> io::Result<SelectedTransitionServer> {
+    start_with_recovery(path, admission, ttl, None, None)
+}
+
+fn start_with_recovery(
+    path: PathBuf,
+    admission: TurnAdmission,
+    ttl: Duration,
+    recovery: Option<tokio::task::AbortHandle>,
+    runtime: Option<NativeSelectedRuntime>,
+) -> io::Result<SelectedTransitionServer> {
+    let parent = path.parent().ok_or(io::ErrorKind::InvalidInput)?;
+    let info = std::fs::symlink_metadata(parent)?;
+    if !path.is_absolute()
+        || !info.is_dir()
+        || info.uid() != unsafe { libc::geteuid() }
+        || info.mode() & 0o077 != 0
+        || path.as_os_str().as_encoded_bytes().len() > 100
+    {
+        return Err(io::ErrorKind::PermissionDenied.into());
+    }
+    // Never replace an existing socket, file or link.
+    let listener = UnixListener::bind(&path)?;
+    let info = std::fs::symlink_metadata(&path)?;
+    let identity = (info.dev(), info.ino());
+    std::fs::set_permissions(&path, std::fs::Permissions::from_mode(0o600))?;
+    let generation = uuid::Uuid::now_v7().to_string();
+    let task = tokio::spawn(async move {
+        let mut connections = JoinSet::new();
+        loop {
+            tokio::select! {
+                accepted = listener.accept() => {
+                    let Ok((stream, _)) = accepted else { break; };
+                    if connections.len() >= 4 { continue; }
+                    let Ok(peer) = stream.peer_cred() else { continue; };
+                    if peer.uid() != unsafe { libc::geteuid() } { continue; }
+                    let admission = admission.clone();
+                    let generation = generation.clone();
+                    let recovery = recovery.clone();
+                    let runtime = runtime.clone();
+                    connections.spawn(async move {
+                        let _ = session(stream, admission, generation, ttl, recovery, runtime).await;
+                    });
+                }
+                _ = connections.join_next(), if !connections.is_empty() => {}
+            }
+        }
+    });
+    Ok(SelectedTransitionServer {
+        task,
+        path,
+        identity,
+    })
+}
+
+async fn read_request<R: AsyncRead + Unpin>(
+    reader: &mut BufReader<R>,
+    duration: Duration,
+) -> io::Result<Request> {
+    let mut line = String::new();
+    tokio::time::timeout(duration, (&mut *reader).take(24577).read_line(&mut line))
+        .await
+        .map_err(|_| io::ErrorKind::TimedOut)??;
+    if line.len() > 24576 || !line.ends_with('\n') {
+        return Err(io::ErrorKind::InvalidInput.into());
+    }
+    let value: Request = serde_json::from_str(&line)?;
+    if value.nonce.len() != 32 || !value.nonce.bytes().all(|b| b.is_ascii_hexdigit()) {
+        return Err(io::ErrorKind::InvalidInput.into());
+    }
+    Ok(value)
+}
+
+async fn send<W: AsyncWrite + Unpin>(writer: &mut W, value: Value) -> io::Result<()> {
+    let mut bytes = serde_json::to_vec(&value)?;
+    if bytes.len() > 1024 * 1024 {
+        return Err(io::ErrorKind::InvalidData.into());
+    }
+    bytes.push(b'\n');
+    tokio::time::timeout(Duration::from_secs(2), writer.write_all(&bytes))
+        .await
+        .map_err(|_| io::ErrorKind::TimedOut)??;
+    Ok(())
+}
+
+fn response(
+    request: &Request,
+    generation: &str,
+    lease: Option<&str>,
+    threads: &[String],
+    held: bool,
+    ttl: Duration,
+) -> Value {
+    json!({
+        "schemaVersion": 1, "producer": "autoapprove-selected-input-lease",
+        "nonce": request.nonce, "serverGeneration": generation, "pid": std::process::id(),
+        "scope": "selected-thread-input", "threadIds": threads, "leaseId": lease,
+        "inputAdmissionPaused": held, "leaseTTLMillis": if held { ttl.as_millis() as u64 } else { 0 },
+        "membershipComplete": false, "existingWorkStopped": false,
+        "goalLifecycleManaged": false, "credentialsTouched": false, "migrationAuthorized": false
+    })
+}
+
+async fn session(
+    stream: UnixStream,
+    admission: TurnAdmission,
+    generation: String,
+    ttl: Duration,
+    recovery: Option<tokio::task::AbortHandle>,
+    runtime: Option<NativeSelectedRuntime>,
+) -> io::Result<()> {
+    let (read, mut writer) = stream.into_split();
+    let mut reader = BufReader::new(read);
+    let inspect = read_request(&mut reader, Duration::from_secs(2)).await?;
+    if inspect.op != "inspect"
+        || inspect.server_generation.is_some()
+        || inspect.lease_id.is_some()
+        || inspect.thread_ids.is_some()
+        || inspect.journal.is_some()
+    {
+        return Err(io::ErrorKind::InvalidInput.into());
+    }
+    let mut inspected = response(&inspect, &generation, None, &[], false, ttl);
+    inspected["runtimeCohortSupported"] = json!(runtime.is_some());
+    inspected["journalLockSupported"] = json!(runtime.is_some());
+    send(&mut writer, inspected).await?;
+    let first = read_request(&mut reader, Duration::from_secs(2)).await?;
+    if !matches!(first.op.as_str(), "pause" | "shutdown-observe")
+        || first.server_generation.as_deref() != Some(&generation)
+        || first.lease_id.is_some()
+        || (first.op == "pause" && first.journal.is_some())
+    {
+        return Err(io::ErrorKind::InvalidInput.into());
+    }
+    let mut names = first
+        .thread_ids
+        .clone()
+        .ok_or(io::ErrorKind::InvalidInput)?;
+    if names.is_empty() || names.len() > 512 {
+        return Err(io::ErrorKind::InvalidInput.into());
+    }
+    let mut threads = HashSet::new();
+    for name in &names {
+        let id = ThreadId::try_from(name.as_str()).map_err(|_| io::ErrorKind::InvalidInput)?;
+        if id.to_string() != *name || !threads.insert(id) {
+            return Err(io::ErrorKind::InvalidInput.into());
+        }
+    }
+    names.sort();
+    if first.op == "shutdown-observe" {
+        let runtime = runtime.as_ref().ok_or(io::ErrorKind::Unsupported)?;
+        let stamp = first.journal.as_ref().ok_or(io::ErrorKind::InvalidInput)?;
+        let status = runtime
+            .observe_shutdown(stamp, &threads)
+            .ok_or(io::ErrorKind::NotFound)?;
+        let reply = json!({"schemaVersion":1,"producer":"autoapprove-selected-shutdown-observation",
+            "nonce":first.nonce,"serverGeneration":generation,"pid":std::process::id(),
+            "threadIds":names,"shutdown":status,"migrationAuthorized":false});
+        send(&mut writer, reply).await?;
+        return Ok(());
+    }
+    // Daemon recovery uses an internal resume path, outside ordinary client
+    // admission. Never grant a selected hold while that startup path is live.
+    if recovery.as_ref().is_some_and(|task| !task.is_finished()) {
+        send(
+            &mut writer,
+            json!({"nonce":first.nonce,"error":"daemon-recovery-in-progress"}),
+        )
+        .await?;
+        return Ok(());
+    }
+    // EOF or pipelined data cancels a pending drain; no detached lease survives.
+    let pause = tokio::select! {
+        value = admission.pause_selected(threads.clone()) => value,
+        _ = reader.fill_buf() => return Err(io::ErrorKind::ConnectionAborted.into()),
+    };
+    let Ok(pause) = pause else {
+        send(
+            &mut writer,
+            json!({"nonce":first.nonce,"error":"selected-input-admission-unavailable"}),
+        )
+        .await?;
+        return Ok(());
+    };
+    let pause = Arc::new(pause);
+    let lease = uuid::Uuid::now_v7().to_string();
+    let mut shutdown: Option<crate::message_processor::NativeSelectedShutdown> = None;
+    let mut journal_lock = None;
+    let mut deadline = Instant::now() + ttl;
+    tokio::time::timeout_at(
+        deadline,
+        send(
+            &mut writer,
+            response(&first, &generation, Some(&lease), &names, true, ttl),
+        ),
+    )
+    .await
+    .map_err(|_| io::ErrorKind::TimedOut)??;
+    loop {
+        if Instant::now() >= deadline {
+            return Err(io::ErrorKind::TimedOut.into());
+        }
+        let request = read_request(
+            &mut reader,
+            deadline.saturating_duration_since(Instant::now()),
+        )
+        .await?;
+        // Buffered input must not renew an already-expired lease.
+        if Instant::now() >= deadline {
+            return Err(io::ErrorKind::TimedOut.into());
+        }
+        if request.server_generation.as_deref() != Some(&generation)
+            || request.lease_id.as_deref() != Some(&lease)
+            || request.thread_ids.is_some()
+            || (!matches!(request.op.as_str(), "journal-lock" | "journal-sync")
+                && request.journal.is_some())
+        {
+            return Err(io::ErrorKind::PermissionDenied.into());
+        }
+        let mut cohort = None;
+        let mut journal_reply = None;
+        let mut shutdown_reply = None;
+        if let Some(lock) = &journal_lock {
+            crate::selected_journal_lock::NativeJournalLock::verify_kernel(lock)?;
+        }
+        match request.op.as_str() {
+            "status" => {}
+            "renew" => deadline = Instant::now() + ttl,
+            "journal-lock" => {
+                if journal_lock.is_some() || !reader.buffer().is_empty() {
+                    return Err(io::ErrorKind::InvalidInput.into());
+                }
+                let runtime = runtime.as_ref().ok_or(io::ErrorKind::Unsupported)?;
+                let stamp = request.journal.clone().ok_or(io::ErrorKind::InvalidInput)?;
+                pause
+                    .verify_scope(&admission, &threads)
+                    .map_err(|error| io::Error::other(error.message))?;
+                let mut ready = response(
+                    &request,
+                    &generation,
+                    Some(&lease),
+                    &names,
+                    true,
+                    deadline.saturating_duration_since(Instant::now()),
+                );
+                ready["journalDescriptorReady"] = json!(true);
+                tokio::time::timeout_at(deadline, send(&mut writer, ready))
+                    .await
+                    .map_err(|_| io::ErrorKind::TimedOut)??;
+                let received = crate::selected_journal_lock::receive(
+                    reader.get_ref().as_ref(),
+                    deadline.min(Instant::now() + Duration::from_secs(2)),
+                )
+                .await?;
+                let lock = runtime.borrow_journal_lock(&pause, &threads, received, stamp)?;
+                journal_reply = Some(lock.reply("held"));
+                journal_lock = Some(lock);
+            }
+            "journal-sync" => {
+                let lock = journal_lock.as_mut().ok_or(io::ErrorKind::InvalidInput)?;
+                lock.refresh(
+                    request.journal.clone().ok_or(io::ErrorKind::InvalidInput)?,
+                    &threads,
+                )?;
+                journal_reply = Some(lock.reply("held"));
+            }
+            "shutdown-begin" => {
+                if shutdown.is_some() {
+                    return Err(io::ErrorKind::AlreadyExists.into());
+                }
+                let runtime = runtime.as_ref().ok_or(io::ErrorKind::Unsupported)?;
+                let lock = journal_lock.as_ref().ok_or(io::ErrorKind::InvalidInput)?;
+                lock.require_source()?;
+                lock.require_phase("shutdownAttempted")?;
+                let value = tokio::time::timeout_at(deadline, runtime.cohort(&pause, &threads))
+                    .await
+                    .map_err(|_| io::ErrorKind::TimedOut)?
+                    .map_err(|error| io::Error::other(error.message))?;
+                if value["knownSubtreeCovered"] != true || value["readyForWriterShutdown"] != true {
+                    return Err(io::ErrorKind::WouldBlock.into());
+                }
+                // Acceptance is synchronous after the final live-peer check.
+                // EOF cannot detach a later archive or ownership publication.
+                if Instant::now() >= deadline || !reader.buffer().is_empty() {
+                    return Err(io::ErrorKind::ConnectionAborted.into());
+                }
+                let mut byte = [0u8; 1];
+                match reader.get_ref().as_ref().try_read(&mut byte) {
+                    Err(error) if error.kind() == io::ErrorKind::WouldBlock => {}
+                    _ => return Err(io::ErrorKind::ConnectionAborted.into()),
+                }
+                let job = runtime.start_shutdown(Arc::clone(&pause), threads.clone(), lock)?;
+                shutdown_reply = Some(job.snapshot());
+                shutdown = Some(job);
+            }
+            "shutdown-status" => {
+                shutdown_reply = Some(shutdown.as_ref().ok_or(io::ErrorKind::NotFound)?.snapshot());
+            }
+            "cohort" => {
+                let runtime = runtime.as_ref().ok_or(io::ErrorKind::Unsupported)?;
+                let value = tokio::time::timeout_at(deadline, runtime.cohort(&pause, &threads))
+                    .await
+                    .map_err(|_| io::ErrorKind::TimedOut)?;
+                cohort = Some(value.map_err(|error| io::Error::other(error.message))?);
+            }
+            "release" => {
+                if shutdown.as_ref().is_some_and(|job| job.pending()) {
+                    return Err(io::ErrorKind::WouldBlock.into());
+                }
+                drop(journal_lock);
+                drop(pause);
+                send(
+                    &mut writer,
+                    response(&request, &generation, Some(&lease), &names, false, ttl),
+                )
+                .await?;
+                return Ok(());
+            }
+            _ => return Err(io::ErrorKind::InvalidInput.into()),
+        }
+        let mut reply = response(
+            &request,
+            &generation,
+            Some(&lease),
+            &names,
+            true,
+            deadline.saturating_duration_since(Instant::now()),
+        );
+        if let Some(cohort) = cohort {
+            reply["runtimeCohort"] = cohort;
+        }
+        if let Some(status) = shutdown_reply {
+            reply["shutdown"] = status;
+        }
+        if let Some(journal) = journal_reply {
+            reply["journalLock"] = journal;
+        }
+        tokio::time::timeout_at(deadline, send(&mut writer, reply))
+            .await
+            .map_err(|_| io::ErrorKind::TimedOut)??;
+    }
+}
+
