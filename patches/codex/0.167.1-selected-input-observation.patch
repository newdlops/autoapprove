+#[cfg(all(feature = "autoapprove-selected-transition", unix))]
+impl NativeSelectedRuntime {
+    pub(crate) fn admission(&self) -> TurnAdmission {
+        self.admission.clone()
+    }
+
+    pub(crate) fn observe_shutdown(
+        &self,
+        stamp: &crate::selected_journal_lock::JournalLockRequest,
+        scope: &std::collections::HashSet<codex_protocol::ThreadId>,
+    ) -> Option<serde_json::Value> {
+        let jobs = self
+            .shutdowns
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        jobs.get(&stamp.request_id)
+            .filter(|job| {
+                job.scope == *scope
+                    && job.stamp.revision == stamp.revision
+                    && job.stamp.digest == stamp.digest
+            })
+            .map(NativeSelectedShutdown::snapshot)
+    }
+
+    pub(crate) fn start_shutdown(
+        &self,
+        pause: Arc<crate::turn_admission::SelectedAdmissionPause>,
+        ids: std::collections::HashSet<codex_protocol::ThreadId>,
+        journal: &crate::selected_journal_lock::NativeJournalLock,
+    ) -> std::io::Result<NativeSelectedShutdown> {
+        journal.require_source()?;
+        journal.require_phase("shutdownAttempted")?;
+        pause
+            .verify_scope(&self.admission, &ids)
+            .map_err(|error| std::io::Error::other(error.message))?;
+        let stamp = journal.stamp();
+        let mut jobs = self
+            .shutdowns
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        if jobs.contains_key(&stamp.request_id) || jobs.len() >= 1024 {
+            return Err(std::io::Error::other(
+                "Shutdown was already submitted; observe it instead of replaying",
+            ));
+        }
+        let (sender, result) = tokio::sync::watch::channel(None);
+        let job = NativeSelectedShutdown {
+            scope: ids.clone(),
+            stamp: stamp.clone(),
+            result,
+        };
+        jobs.insert(stamp.request_id.clone(), job.clone());
+        let threads = self.threads.clone();
+        let admission = self.admission.clone();
+        let kernel = journal.retain_kernel();
+        tokio::spawn(async move {
+            let result = match kernel.verify() {
+                Err(_) => Err("journal-lock-changed-before-shutdown".to_owned()),
+                Ok(()) => threads
+                    .native_shutdown_selected(&admission, &pause, &ids)
+                    .await
+                    .map_err(|error| error.message),
+            };
+            // This task never publishes ownership. EOF cannot detach a later
+            // archive or policy write; only the accepted shutdown continues.
+            drop(kernel);
+            drop(pause);
+            sender.send_replace(Some(result));
+        });
+        Ok(job)
+    }
+
+    pub(crate) fn borrow_journal_lock(
+        &self,
+        pause: &crate::turn_admission::SelectedAdmissionPause,
+        ids: &std::collections::HashSet<codex_protocol::ThreadId>,
+        descriptor: std::os::fd::OwnedFd,
+        stamp: crate::selected_journal_lock::JournalLockRequest,
+    ) -> std::io::Result<crate::selected_journal_lock::NativeJournalLock> {
+        pause
+            .verify_scope(&self.admission, ids)
+            .map_err(|error| std::io::Error::other(error.message))?;
+        crate::selected_journal_lock::NativeJournalLock::acquire(
+            &self.threads.native_move_home(),
+            descriptor,
+            stamp,
+            ids,
+        )
+    }
+
+    pub(crate) async fn cohort(
+        &self,
+        pause: &crate::turn_admission::SelectedAdmissionPause,
+        ids: &std::collections::HashSet<codex_protocol::ThreadId>,
+    ) -> Result<serde_json::Value, codex_app_server_protocol::JSONRPCErrorError> {
+        self.threads
+            .native_move_cohort(&self.admission, pause, ids, &self.queues)
+            .await
+    }
