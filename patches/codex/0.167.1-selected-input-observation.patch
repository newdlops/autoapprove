+            | ClientRequest::AutoapproveGoalRead { .. }
+            | ClientRequest::ThreadQueueList { .. }
+            | ClientRequest::ThreadBackgroundTerminalsList { .. }
+            | ClientRequest::TurnInterrupt { .. }
