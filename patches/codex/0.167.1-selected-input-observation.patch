+#[cfg(all(feature = "autoapprove-selected-transition", unix))]
+impl NativeSelectedShutdown {
+    pub(crate) fn pending(&self) -> bool {
+        self.result.borrow().is_none() && self.result.has_changed().is_ok()
+    }
+    pub(crate) fn snapshot(&self) -> serde_json::Value {
+        let value = self.result.borrow().clone();
+        let (state, error) = match value {
+            Some(Ok(())) => ("stopped", None),
+            Some(Err(error)) => ("failed", Some(error)),
+            None if self.result.has_changed().is_err() => {
+                ("failed", Some("shutdown-task-ended-without-result".into()))
+            }
+            None => ("pending", None),
+        };
+        serde_json::json!({"requestId":self.stamp.request_id,"state":state,"error":error,
+            "runtimesStopped":state=="stopped","writersStopped":false,"observationOnly":true,"migrationAuthorized":false})
+    }
+}
