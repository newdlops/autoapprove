+//! Read the selected native runtime under its actual drained input guard.
+//! This establishes known subtree coverage, not a complete client census or a
+//! migration grant. No runtime, queue, Goal or rollout is mutated by this read.
+use super::*;
+use crate::request_processors::ThreadQueueRequestProcessor;
+use crate::turn_admission::{SelectedAdmissionPause, TurnAdmission};
+use codex_app_server_protocol::ThreadGoalStatus;
+use codex_protocol::protocol::AgentStatus;
+use serde_json::{Value, json};
+
+impl ThreadRequestProcessor {
+    pub(crate) async fn native_move_cohort(
+        &self,
+        admission: &TurnAdmission,
+        pause: &SelectedAdmissionPause,
+        ids: &HashSet<ThreadId>,
+        queues: &ThreadQueueRequestProcessor,
+    ) -> Result<Value, JSONRPCErrorError> {
+        pause.verify_scope(admission, ids)?;
+        let mut known = HashSet::new();
+        for id in ids {
+            known.extend(self.state_db_spawn_subtree_thread_ids(*id).await?);
+            if known.len() > 4096 {
+                return Err(invalid_request(
+                    "The affected conversation subtree is too large",
+                ));
+            }
+        }
+        let mut missing: Vec<_> = known.difference(ids).map(ToString::to_string).collect();
+        missing.sort();
+        let mut sorted: Vec<_> = ids.iter().copied().collect();
+        sorted.sort_by_key(ToString::to_string);
+        let mut rows = Vec::new();
+        let mut ready = missing.is_empty();
+        for id in sorted {
+            let thread = self
+                .thread_manager
+                .capture_thread_for_client_removal(&id)
+                .await
+                .map_err(|error| core_thread_write_error("observe move", error))?;
+            let (loaded, active, background, persistent, status) = if let Some(thread) = &thread {
+                let config = thread.config_snapshot().await;
+                let status = match thread.agent_status().await {
+                    AgentStatus::PendingInit => "pending-init",
+                    AgentStatus::Running => "running",
+                    AgentStatus::Interrupted => "interrupted",
+                    AgentStatus::Completed(_) => "completed",
+                    AgentStatus::Errored(_) => "errored",
+                    AgentStatus::Shutdown => "shutdown",
+                    AgentStatus::NotFound => "not-found",
+                };
+                (
+                    true,
+                    thread.has_active_turn().await,
+                    !thread.list_background_terminals().await.is_empty(),
+                    !config.ephemeral,
+                    status,
+                )
+            } else {
+                // Absence from the manager is not evidence that a fabricated ID
+                // is a persisted conversation. Require the actual store entry.
+                self.thread_store
+                    .read_thread(StoreReadThreadParams {
+                        thread_id: id,
+                        include_archived: true,
+                        include_history: false,
+                    })
+                    .await
+                    .map_err(|error| thread_store_mutation_error("observe move", error))?;
+                (false, false, false, true, "not-loaded")
+            };
+            let (goal, goal_id) = self.thread_goal_processor.native_move_goal(id).await?;
+            let queued = queues.native_move_has_queued_input(id).await?;
+            let protected = self.outgoing.native_move_has_pending_request(id).await;
+            let active_goal = goal
+                .as_ref()
+                .is_some_and(|goal| goal.status == ThreadGoalStatus::Active);
+            let safe =
+                persistent && !active && !background && !protected && !queued && !active_goal;
+            ready &= safe;
+            rows.push(json!({
+                "threadId": id.to_string(), "loaded": loaded, "hasActiveTurn": active,
+                "status": status, "persistent": persistent, "hasBackgroundTerminal": background,
+                "hasProtectedRequest": protected, "hasQueuedInput": queued, "goal": goal, "goalId": goal_id,
+                "readyForWriterShutdown": safe,
+            }));
+        }
+        pause.verify_scope(admission, ids)?;
+        Ok(json!({
+            "producer": "autoapprove-selected-runtime-cohort", "schemaVersion": 1,
+            "threads": rows, "missingThreadIds": missing,
+            "knownSubtreeCovered": known.is_subset(ids),
+            "readyForWriterShutdown": ready,
+            "inputScopeVerified": true, "membershipComplete": false,
+            "writersStopped": false, "migrationAuthorized": false,
+        }))
+    }
+}
