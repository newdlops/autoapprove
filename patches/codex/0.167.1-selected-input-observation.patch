+    fn policy_lock_serializes_updates_and_same_home_retirement_is_rejected() -> io::Result<()> {
+        let f = Fixture::new()?;
+        let held = PolicyLock::acquire(&f.home)?.0;
+        let mut change = request(Transition::Incoming, 0, vec![id()]);
+        assert_eq!(
+            apply(&f.home, &change, || Ok(())).unwrap_err().kind(),
+            io::ErrorKind::WouldBlock
+        );
+        drop(held);
+        change.transition = Transition::Retire;
+        change.destination_home_identity = Some(f.id.clone());
+        assert!(apply(&f.home, &change, || Ok(())).is_err());
+        assert_eq!(revision(&f.home)?, 0);
+        Ok(())
+    }
+}
