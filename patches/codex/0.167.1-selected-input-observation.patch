+    async fn native_hold_cancel_does_not_remove_the_gate_before_event_loop_drain() {
+        let hold = InputHold::new(TTL);
+        assert!(hold.install());
+        hold.cancel();
+        assert!(!hold.active());
+        assert!(hold.installed());
+        assert!(
+            tokio::time::timeout(Duration::from_millis(20), hold.uninstalled())
+                .await
+                .is_err()
+        );
+        hold.finish();
+        hold.uninstalled().await;
+        assert!(!hold.installed());
+        assert!(!hold.install());
+    }
+    #[tokio::test]
+    async fn native_hold_private_path_and_replacement_are_preserved() -> anyhow::Result<()> {
+        let (root, server, _rx) = fixture(TTL)?;
+        let path = root.path().join("hold.sock");
+        let (tx, _) = tokio::sync::mpsc::unbounded_channel();
+        assert!(start_at(path.clone(), AppEventSender::new(tx), TTL).is_err());
+        assert_eq!(std::fs::symlink_metadata(&path)?.mode() & 0o777, 0o600);
+        std::fs::remove_file(&path)?;
+        std::fs::write(&path, b"replacement")?;
+        drop(server);
+        assert_eq!(std::fs::read(&path)?, b"replacement");
+        Ok(())
+    }
+}
+async fn session(
+    stream: UnixStream,
+    events: AppEventSender,
+    generation: String,
+    active: Arc<Mutex<Weak<InputHold>>>,
+    ttl: Duration,
+) -> io::Result<()> {
+    let (read, mut write) = stream.into_split();
+    let mut reader = BufReader::new(read);
+    let mut owner: Option<Owner> = None;
+    loop {
+        let limit = owner
+            .as_ref()
+            .map(|owner| owner.0.remaining())
+            .unwrap_or(Duration::from_secs(2));
+        if limit.is_zero() {
+            return Err(io::ErrorKind::TimedOut.into());
+        }
+        let request = request(&mut reader, limit).await?;
+        if let Some(owner) = &owner
+            && !owner.0.active()
+        {
+            return Err(io::ErrorKind::TimedOut.into());
+        }
+        if request.op == "inspect" && owner.is_none() && request.lease_id.is_none() {
+            send(&mut write, response(&request, &generation, None), limit).await?;
+            continue;
+        }
+        if request.generation.as_deref() != Some(&generation) {
+            return Err(io::ErrorKind::InvalidInput.into());
+        }
+        if request.op == "pause" && owner.is_none() && request.lease_id.is_none() {
+            let hold = Arc::new(InputHold::new(ttl));
+            {
+                let mut current = active.lock().map_err(|_| io::ErrorKind::Other)?;
+                if current.upgrade().is_some_and(|held| held.active()) {
+                    return Err(io::ErrorKind::WouldBlock.into());
+                }
+                *current = Arc::downgrade(&hold);
+            }
+            owner = Some(Owner(hold.clone()));
+            let (reply, received) = oneshot::channel();
+            events
+                .app_event_tx
+                .send(AppEvent::AutoapproveInputHold { hold, reply })
+                .map_err(|_| io::ErrorKind::BrokenPipe)?;
+            let attached = tokio::select! {
+                result = tokio::time::timeout(Duration::from_secs(2), received) => result.ok().and_then(Result::ok).unwrap_or(false),
+                _ = reader.fill_buf() => false
+            };
+            if !attached || !owner.as_ref().unwrap().0.active() {
+                return Err(io::ErrorKind::Interrupted.into());
+            }
+        } else {
+            let Some(current) = &owner else {
+                return Err(io::ErrorKind::InvalidInput.into());
+            };
+            if request.lease_id.as_deref() != Some(&current.0.id) {
+                return Err(io::ErrorKind::InvalidInput.into());
+            }
+            match request.op.as_str() {
+                "status" => {}
+                "renew" if current.0.renew(ttl) => {}
+                "release" => {
+                    current.0.cancel();
+                    tokio::time::timeout(Duration::from_secs(2), current.0.uninstalled())
+                        .await
+                        .map_err(|_| io::ErrorKind::TimedOut)?;
+                }
+                _ => return Err(io::ErrorKind::InvalidInput.into()),
+            }
+        }
+        let remaining = owner
+            .as_ref()
+            .map(|owner| owner.0.remaining())
+            .unwrap_or(limit);
+        send(
+            &mut write,
+            response(&request, &generation, owner.as_ref()),
+            if request.op == "release" {
+                Duration::from_secs(2)
+            } else {
+                remaining
+            },
+        )
+        .await?;
+        if request.op == "release" {
+            return Ok(());
+        }
+    }
+}
