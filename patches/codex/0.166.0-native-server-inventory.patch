+//! Opt-in, local read-only prototype. Never an admission grant for migration.
+use super::InventoryRead;
+use serde::Deserialize;
+use serde_json::Value;
+use std::io;
+use std::os::unix::fs::MetadataExt;
+use std::os::unix::fs::PermissionsExt;
+use std::path::PathBuf;
+use std::time::Duration;
+use tokio::io::AsyncBufReadExt;
+use tokio::io::AsyncReadExt;
+use tokio::io::AsyncWriteExt;
+use tokio::io::BufReader;
+use tokio::net::UnixListener;
+use tokio::sync::mpsc;
+use tokio::sync::oneshot;
+use tokio::task::JoinHandle;
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct ReadRequest {
+    nonce: String,
+}
+
+pub(crate) struct InventoryServer {
+    task: JoinHandle<()>,
+    path: PathBuf,
+    identity: (u64, u64),
+}
+
+impl Drop for InventoryServer {
+    fn drop(&mut self) {
+        self.task.abort();
+        if let Ok(info) = std::fs::symlink_metadata(&self.path)
+            && (info.dev(), info.ino()) == self.identity
+        {
+            let _ = std::fs::remove_file(&self.path);
+        }
+    }
+}
+
+fn private_parent(path: &std::path::Path) -> io::Result<()> {
+    let parent = path.parent().ok_or(io::ErrorKind::InvalidInput)?;
+    let info = std::fs::symlink_metadata(parent)?;
+    if !path.is_absolute()
+        || !info.is_dir()
+        || info.uid() != unsafe { libc::geteuid() }
+        || info.mode() & 0o077 != 0
+        || path.as_os_str().as_encoded_bytes().len() > 100
+    {
+        return Err(io::ErrorKind::PermissionDenied.into());
+    }
+    Ok(())
+}
+
+pub(crate) fn start(events: mpsc::Sender<InventoryRead>) -> io::Result<Option<InventoryServer>> {
+    let Some(path) = std::env::var_os("AUTOAPPROVE_NATIVE_SERVER_INVENTORY_SOCKET") else {
+        return Ok(None);
+    };
+    start_at(PathBuf::from(path), events).map(Some)
+}
+
+fn start_at(path: PathBuf, events: mpsc::Sender<InventoryRead>) -> io::Result<InventoryServer> {
+    private_parent(&path)?;
+    // bind is exclusive: existing sockets, files and links are never replaced.
+    let listener = UnixListener::bind(&path)?;
+    let info = std::fs::symlink_metadata(&path)?;
+    let identity = (info.dev(), info.ino());
+    std::fs::set_permissions(&path, std::fs::Permissions::from_mode(0o600))?;
+    let task = tokio::spawn(async move {
+        loop {
+            let Ok((mut stream, _)) = listener.accept().await else {
+                break;
+            };
+            let Ok(peer) = stream.peer_cred() else {
+                continue;
+            };
+            if peer.uid() != unsafe { libc::geteuid() } {
+                continue;
+            }
+            // One bounded request at a time; no detached per-client task flood.
+            let _ = tokio::time::timeout(Duration::from_secs(2), async {
+                let mut line = String::new();
+                let mut reader = BufReader::new((&mut stream).take(1025));
+                reader.read_line(&mut line).await?;
+                if line.len() > 1024 || !line.ends_with('\n') {
+                    return Err::<(), io::Error>(io::ErrorKind::InvalidInput.into());
+                }
+                let request: ReadRequest = serde_json::from_str(&line)?;
+                if request.nonce.len() != 32
+                    || !request.nonce.bytes().all(|v| v.is_ascii_hexdigit())
+                {
+                    return Err(io::ErrorKind::InvalidInput.into());
+                }
+                let (reply, received) = oneshot::channel::<Value>();
+                // Bypass session logging: this is not user input or a Codex turn.
+                events
+                    .send(InventoryRead {
+                        nonce: request.nonce,
+                        reply,
+                    })
+                    .await
+                    .map_err(|_| io::ErrorKind::BrokenPipe)?;
+                let response = received.await.map_err(|_| io::ErrorKind::BrokenPipe)?;
+                let mut bytes = serde_json::to_vec(&response)?;
+                if bytes.len() > 1024 * 1024 {
+                    return Err(io::ErrorKind::InvalidData.into());
+                }
+                bytes.push(b'\n');
+                drop(reader);
+                stream.write_all(&bytes).await?;
+                stream.shutdown().await
+            })
+            .await;
+        }
+    });
+    Ok(InventoryServer {
+        task,
+        path,
+        identity,
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[tokio::test]
+    async fn exclusive_private_socket_and_event_loop_nonce() -> anyhow::Result<()> {
+        let root = tempfile::tempdir_in("/private/tmp")?;
+        std::fs::set_permissions(root.path(), std::fs::Permissions::from_mode(0o700))?;
+        let path = root.path().join("inventory.sock");
+        let (tx, mut rx) = tokio::sync::mpsc::channel(1);
+        let events = tx;
+        let server = start_at(path.clone(), events.clone())?;
+        assert!(start_at(path.clone(), events).is_err());
+        assert_eq!(std::fs::symlink_metadata(&path)?.mode() & 0o777, 0o600);
+        let mut socket = tokio::net::UnixStream::connect(&path).await?;
+        socket
+            .write_all(b"{\"nonce\":\"0123456789abcdef0123456789abcdef\"}\n")
+            .await?;
+        let InventoryRead { nonce, reply } = rx.recv().await.unwrap();
+        reply
+            .send(serde_json::json!({"nonce":nonce,"eligibleForMigration":false}))
+            .unwrap();
+        let mut line = String::new();
+        BufReader::new(socket).read_line(&mut line).await?;
+        assert_eq!(
+            serde_json::from_str::<Value>(&line)?["nonce"],
+            "0123456789abcdef0123456789abcdef"
+        );
+        drop(server);
+        assert!(!path.exists());
+        Ok(())
+    }
+
+    #[tokio::test]
+    async fn rejects_public_or_linked_parent_without_touching_files() -> anyhow::Result<()> {
+        let root = tempfile::tempdir_in("/private/tmp")?;
+        let actual = root.path().join("actual");
+        std::fs::create_dir(&actual)?;
+        std::fs::set_permissions(&actual, std::fs::Permissions::from_mode(0o755))?;
+        assert!(private_parent(&actual.join("i.sock")).is_err());
+        std::fs::set_permissions(&actual, std::fs::Permissions::from_mode(0o700))?;
+        let alias = root.path().join("alias");
+        std::os::unix::fs::symlink(&actual, &alias)?;
+        assert!(private_parent(&alias.join("i.sock")).is_err());
+        assert!(!actual.join("i.sock").exists());
+        Ok(())
+    }
+
+    #[tokio::test]
+    async fn malformed_request_enqueues_nothing_and_existing_file_is_preserved()
+    -> anyhow::Result<()> {
+        let root = tempfile::tempdir_in("/private/tmp")?;
+        std::fs::set_permissions(root.path(), std::fs::Permissions::from_mode(0o700))?;
+        let path = root.path().join("i.sock");
+        let (tx, mut rx) = tokio::sync::mpsc::channel(1);
+        let events = tx;
+        std::fs::write(&path, b"existing")?;
+        assert!(start_at(path.clone(), events.clone()).is_err());
+        assert_eq!(std::fs::read(&path)?, b"existing");
+        std::fs::remove_file(&path)?;
+        let server = start_at(path.clone(), events)?;
+        let mut socket = tokio::net::UnixStream::connect(&path).await?;
+        socket
+            .write_all(b"{\"nonce\":\"bad\",\"command\":\"run\"}\n")
+            .await?;
+        let mut bytes = Vec::new();
+        tokio::time::timeout(Duration::from_secs(3), socket.read_to_end(&mut bytes)).await??;
+        assert!(bytes.is_empty());
+        assert!(rx.try_recv().is_err());
+        std::fs::remove_file(&path)?;
+        std::fs::write(&path, b"replacement")?;
+        drop(server);
+        assert_eq!(std::fs::read(&path)?, b"replacement");
+        Ok(())
+    }
+}
