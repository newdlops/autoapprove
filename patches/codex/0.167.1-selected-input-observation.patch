+                        && selected
+                            .iter()
+                            .all(|id| !state.selected_active.contains_key(id));
+                    let inputs_finished = selected
+                        .iter()
+                        .all(|id| !state.selected_inputs.contains_key(id));
+                    // An RPC accepted before closure must be allowed to deliver
+                    // its input through Core. Close Core only after those RPCs
+                    // finish, then drain already-admitted Core submissions.
+                    if requests_finished {
+                        state.selected_inputs_closed = true;
+                    }
+                    if requests_finished && inputs_finished {
+                        return Ok(());
+                    }
+                }
+                revision
+                    .changed()
+                    .await
+                    .map_err(|_| invalid_request("Conversation admission is unavailable"))?;
+            }
+        })
+        .await
+        .map_err(|_| invalid_request("Selected conversations still have pending input"))??;
+        Ok(pause)
