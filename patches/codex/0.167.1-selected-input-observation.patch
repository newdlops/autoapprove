+    pub(crate) fn admit_selected_scope(
+        &self,
+        thread: Option<ThreadId>,
+    ) -> Result<SelectedAdmissionPermit, JSONRPCErrorError> {
+        let mut state = self
+            .state
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        if state
+            .selected
+            .as_ref()
+            .is_some_and(|ids| thread.is_none_or(|id| ids.contains(&id)))
+        {
+            return Err(invalid_request(
+                "Selected conversation is preparing to move; input was not accepted",
+            ));
+        }
+        if let Some(id) = thread {
+            *state.selected_active.entry(id).or_default() += 1;
+        } else {
+            state.unscoped_active += 1;
+        }
+        Ok(SelectedAdmissionPermit {
+            admission: self.clone(),
+            thread,
+            input: false,
+        })
+    }
