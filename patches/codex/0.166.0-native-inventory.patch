+//! Event-loop snapshot of actual retained TUI state, with no text or auth export.
+use super::App;
+use codex_protocol::ThreadId;
+use serde_json::Value;
+use serde_json::json;
+use std::collections::BTreeMap;
+
+fn ids(values: impl IntoIterator<Item = ThreadId>) -> Vec<String> {
+    let mut result: Vec<_> = values.into_iter().map(|v| v.to_string()).collect();
+    result.sort();
+    result.dedup();
+    result
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::app::side::SideThreadState;
+
+    #[tokio::test]
+    async fn includes_unsubscribed_navigation_side_parent_and_retained_draft_without_mutation() {
+        let mut app = crate::app::test_support::make_test_app().await;
+        let primary = ThreadId::new();
+        let offscreen = ThreadId::new();
+        let side = ThreadId::new();
+        let parked = ThreadId::new();
+        app.primary_thread_id = Some(primary);
+        app.active_thread_id = Some(primary);
+        app.agent_navigation.upsert(offscreen, None, None, false);
+        app.side_threads.insert(side, SideThreadState::new(primary));
+        app.chat_widget
+            .insert_str("PRIVATE DRAFT: must stay in the native widget");
+        let retained = app.chat_widget.capture_thread_input_state().unwrap();
+        app.agents_overview
+            .input_states
+            .insert(parked, retained.clone());
+        let before = app.chat_widget.composer_text_with_pending();
+        let value = app.autoapprove_inventory("0123456789abcdef0123456789abcdef".into());
+        assert_eq!(
+            value["stores"]["navigation"],
+            json!([offscreen.to_string()])
+        );
+        assert_eq!(value["stores"]["sideThreads"], json!([side.to_string()]));
+        assert_eq!(value["stores"]["sideParents"], json!([primary.to_string()]));
+        assert_eq!(
+            value["stores"]["overviewInput"],
+            json!([parked.to_string()])
+        );
+        assert_eq!(
+            value["retainedInputs"][parked.to_string()]["hasDraft"],
+            true
+        );
+        assert_eq!(value["currentWidget"]["hasDraft"], true);
+        assert_eq!(app.chat_widget.composer_text_with_pending(), before);
+        assert_eq!(app.agents_overview.input_states[&parked], retained);
+        assert!(!value.to_string().contains("PRIVATE DRAFT"));
+        assert!(app.thread_event_listener_tasks.is_empty());
+        assert_eq!(value["membershipComplete"], false);
+        assert_eq!(value["admissionGranted"], false);
+    }
+}
+
+impl App {
+    pub(super) fn autoapprove_inventory(&self, nonce: String) -> Value {
+        let mut stores = BTreeMap::<&str, Vec<String>>::new();
+        stores.insert("primary", ids(self.primary_thread_id));
+        stores.insert("active", ids(self.active_thread_id));
+        stores.insert("displayedWidget", ids(self.chat_widget.thread_id()));
+        stores.insert("channels", ids(self.thread_event_channels.keys().copied()));
+        stores.insert(
+            "listeners",
+            ids(self.thread_event_listener_tasks.keys().copied()),
+        );
+        stores.insert(
+            "navigation",
+            self.agent_navigation.autoapprove_retained_ids(),
+        );
+        stores.insert("sideThreads", ids(self.side_threads.keys().copied()));
+        stores.insert(
+            "sideParents",
+            ids(self.side_threads.values().map(|v| v.parent_thread_id)),
+        );
+        stores.insert(
+            "abandonedSides",
+            ids(self.abandoned_side_threads.iter().copied()),
+        );
+        stores.insert(
+            "speechReplay",
+            ids(self.pending_realtime_speech_replay.keys().copied()),
+        );
+        stores.insert(
+            "transcriptReplay",
+            ids(self.pending_realtime_transcript_replay.keys().copied()),
+        );
+        stores.insert(
+            "replayOrder",
+            ids(self.realtime_replay_order.iter().copied()),
+        );
+        stores.insert(
+            "backgroundVoice",
+            ids(self.background_voice.as_ref().and_then(|v| v.thread_id())),
+        );
+        stores.insert(
+            "backgroundVoiceError",
+            ids(self.background_voice_error.as_ref().map(|v| v.0)),
+        );
+        stores.insert(
+            "temporaryRequests",
+            ids(self.temporary_structured_requests.keys().copied()),
+        );
+        stores.insert(
+            "pendingTitles",
+            ids(self.pending_thread_titles.keys().map(|v| v.0)),
+        );
+        stores.insert(
+            "overviewInput",
+            ids(self.agents_overview.input_states.keys().copied()),
+        );
+        stores.insert(
+            "overviewBlankSessions",
+            ids(self.agents_overview.blank_sessions.keys().copied()),
+        );
+        stores.insert(
+            "overviewRequests",
+            ids(self.agents_overview.dispatched_requests.keys().copied()),
+        );
+        stores.insert(
+            "pendingProfiles",
+            ids(self.pending_server_profiles.keys().copied()),
+        );
+        // Catalog references are deliberately distinct from routing/input ownership.
+        stores.insert(
+            "catalogReferences",
+            ids(self.agents_overview.threads.keys().copied()),
+        );
+        let retained_inputs: BTreeMap<_, _> = self
+            .agents_overview
+            .input_states
+            .iter()
+            .map(|(id, state)| (id.to_string(), state.autoapprove_inventory_flags()))
+            .collect();
+        json!({
+            "schemaVersion": 1,
+            "producer": "autoapprove-native-tui-prototype",
+            "upstreamCommit": "6ff1e1ca3b30fc8b914720681fcf5fe62e95f856",
+            "cliVersion": env!("CARGO_PKG_VERSION"),
+            "pid": std::process::id(),
+            "nonce": nonce,
+            "stores": stores,
+            "retainedInputs": retained_inputs,
+            "currentWidget": {
+                "hasDraft": !self.chat_widget.composer_is_empty(),
+                "hasProtectedRequest": self.chat_widget.has_pending_protected_request(),
+                "hasQueuedInput": self.chat_widget.has_queued_follow_up_messages(),
+                "hasActiveView": self.chat_widget.has_active_view()
+            },
+            "pending": {
+                "voiceOwner": self.background_voice.is_some(),
+                "primaryEvents": !self.pending_primary_events.is_empty(),
+                "threadSwitches": self.pending_thread_switch_resets,
+                "dynamicTools": self.dynamic_tool_tasks.len(),
+                "startupThread": self.pending_startup_thread_start,
+                "resumePicker": self.pending_open_resume_picker,
+                "workingDirectory": self.pending_working_directory_change.is_some(),
+                "worktreeStart": self.pending_start_managed_worktree.is_some(),
+                "worktreeCreation": self.pending_managed_worktree_creation,
+                "worktreeCreated": self.pending_managed_worktree_created.is_some(),
+                "worktreeTransition": self.pending_managed_worktree_transition.is_some(),
+                "worktreeAttach": self.pending_managed_worktree_attach.is_some(),
+                "newSessionDraft": self.agents_overview.new_session_draft.is_some()
+            },
+            "membershipComplete": false,
+            "admissionGranted": false,
+            "limitations": ["daemon-peer-census-required", "revision-and-admission-barrier-required", "full-preservation-export-required"]
+        })
+    }
+}
