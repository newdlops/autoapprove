+    }
+    async fn held(path: &std::path::Path, thread: ThreadId) -> (BufReader<UnixStream>, Value) {
+        let mut stream = BufReader::new(UnixStream::connect(path).await.unwrap());
+        let inspect = rpc(
+            &mut stream,
+            json!({"op":"inspect","nonce":"0123456789abcdef0123456789abcdef"}),
