+//! Private discovery hints for explicitly enabled maintained native clients.
+//! A registration is never proof of live ownership or migration authorization.
+use crate::native_current_process_identity;
+use serde_json::json;
+use std::fs::{File, OpenOptions};
+use std::io::{self, Write};
+use std::os::unix::fs::{DirBuilderExt, MetadataExt, OpenOptionsExt};
+use std::path::{Path, PathBuf};
+
+#[derive(Clone, Copy)]
+pub enum NativeRuntimeRole {
+    Tui,
+    Server,
+}
+impl NativeRuntimeRole {
+    fn name(self) -> &'static str {
+        match self {
+            Self::Tui => "tui",
+            Self::Server => "server",
+        }
+    }
+    fn prefix(self) -> &'static str {
+        match self {
+            Self::Tui => "t",
+            Self::Server => "s",
+        }
+    }
+    fn control(self) -> &'static str {
+        match self {
+            Self::Tui => "terminal-input-hold",
+            Self::Server => "selected-input-lease",
+        }
+    }
+    fn overrides(self) -> [&'static str; 2] {
+        match self {
+            Self::Tui => [
+                "AUTOAPPROVE_NATIVE_INVENTORY_SOCKET",
+                "AUTOAPPROVE_TUI_INPUT_HOLD_SOCKET",
+            ],
+            Self::Server => [
+                "AUTOAPPROVE_NATIVE_SERVER_INVENTORY_SOCKET",
+                "AUTOAPPROVE_SELECTED_TRANSITION_SOCKET",
+            ],
+        }
+    }
+}
+pub struct NativeRuntimeRegistration {
+    root: PathBuf,
+    directory: PathBuf,
+    root_id: (u64, u64),
+    directory_id: (u64, u64),
+    role: NativeRuntimeRole,
+    home: PathBuf,
+    id: String,
+    files: Vec<(PathBuf, (u64, u64), u32)>,
+    _root_guard: File,
+    _directory_guard: File,
+    record: Option<File>,
+}
+fn private_directory(path: &Path) -> io::Result<(u64, u64)> {
+    let metadata = std::fs::symlink_metadata(path)?;
+    if !metadata.is_dir()
+        || metadata.uid() != unsafe { libc::geteuid() }
+        || metadata.mode() & 0o077 != 0
+    {
+        return Err(io::ErrorKind::PermissionDenied.into());
+    }
+    Ok((metadata.dev(), metadata.ino()))
+}
+impl NativeRuntimeRegistration {
+    pub fn from_environment(role: NativeRuntimeRole, home: &Path) -> io::Result<Option<Self>> {
+        if !cfg!(feature = "autoapprove-native-inventory") {
+            return Ok(None);
+        }
+        let Some(root) = std::env::var_os("AUTOAPPROVE_NATIVE_RUNTIME_ROOT") else {
+            return Ok(None);
+        };
+        // Explicit endpoint tests/configuration retain their existing behavior.
+        if role
+            .overrides()
+            .iter()
+            .any(|name| std::env::var_os(name).is_some())
+        {
+            return Ok(None);
+        }
+        Self::create(PathBuf::from(root), role, home).map(Some)
+    }
+    fn create(root: PathBuf, role: NativeRuntimeRole, home: &Path) -> io::Result<Self> {
+        if !root.is_absolute()
+            || root.as_os_str().as_encoded_bytes().len() > 40
+            || root.canonicalize()? != root
+        {
+            return Err(io::ErrorKind::InvalidInput.into());
+        }
+        let root_id = private_directory(&root)?;
+        let root_guard = OpenOptions::new()
+            .read(true)
+            .custom_flags(libc::O_DIRECTORY | libc::O_NOFOLLOW | libc::O_CLOEXEC)
+            .open(&root)?;
+        let pinned = root_guard.metadata()?;
+        if (pinned.dev(), pinned.ino()) != root_id {
+            return Err(io::ErrorKind::PermissionDenied.into());
+        }
+        let home = home.canonicalize()?;
+        let home_info = std::fs::symlink_metadata(&home)?;
+        if !home_info.is_dir() || home_info.uid() != unsafe { libc::geteuid() } {
+            return Err(io::ErrorKind::PermissionDenied.into());
+        }
+        let id = uuid::Uuid::now_v7();
+        let directory = root.join(format!(
+            "{}-{}-{}",
+            role.prefix(),
+            std::process::id(),
+            id.simple()
+        ));
+        std::fs::DirBuilder::new().mode(0o700).create(&directory)?;
+        let directory_id = private_directory(&directory)?;
+        let directory_guard = OpenOptions::new()
+            .read(true)
+            .custom_flags(libc::O_DIRECTORY | libc::O_NOFOLLOW | libc::O_CLOEXEC)
+            .open(&directory)?;
+        let pinned = directory_guard.metadata()?;
+        if (pinned.dev(), pinned.ino()) != directory_id {
+            return Err(io::ErrorKind::PermissionDenied.into());
+        }
+        let value = Self {
+            root,
+            directory,
+            root_id,
+            directory_id,
+            role,
+            home,
+            id: id.to_string(),
+            files: Vec::new(),
+            _root_guard: root_guard,
+            _directory_guard: directory_guard,
+            record: None,
+        };
+        value.verify()?;
+        Ok(value)
+    }
+    fn verify(&self) -> io::Result<()> {
+        if private_directory(&self.root)? != self.root_id
+            || private_directory(&self.directory)? != self.directory_id
+        {
+            return Err(io::ErrorKind::PermissionDenied.into());
+        }
+        Ok(())
+    }
+    pub fn inventory_path(&self) -> PathBuf {
+        self.directory.join("i.sock")
+    }
+    pub fn control_path(&self) -> PathBuf {
+        self.directory.join("c.sock")
+    }
+    pub fn publish(&mut self) -> io::Result<()> {
+        self.verify()?;
+        if !self.files.is_empty() {
+            return Err(io::ErrorKind::AlreadyExists.into());
+        }
+        for path in [self.inventory_path(), self.control_path()] {
+            let info = std::fs::symlink_metadata(&path)?;
+            if info.mode() & libc::S_IFMT as u32 != libc::S_IFSOCK as u32
+                || info.uid() != unsafe { libc::geteuid() }
+                || info.mode() & 0o077 != 0
+            {
+                return Err(io::ErrorKind::PermissionDenied.into());
+            }
+            self.files
+                .push((path, (info.dev(), info.ino()), libc::S_IFSOCK as u32));
+        }
+        let identity = native_current_process_identity().ok_or(io::ErrorKind::Unsupported)?;
+        let data = serde_json::to_vec(&json!({
+            "schemaVersion":1,"producer":"autoapprove-native-runtime-registration",
+            "cliVersion":env!("CARGO_PKG_VERSION"),"registrationId":self.id,
+            "role":self.role.name(),"controlKind":self.role.control(),"pid":std::process::id(),
+            "processIdentity":identity,"home":self.home,
+            "inventorySocket":"i.sock","controlSocket":"c.sock",
+            "membershipComplete":false,"migrationAuthorized":false
+        }))?;
+        let path = self.directory.join("registration.json");
+        let file = OpenOptions::new()
+            .write(true)
+            .create_new(true)
+            .mode(0o600)
+            .custom_flags(libc::O_NOFOLLOW | libc::O_CLOEXEC)
+            .open(&path)?;
+        let info = file.metadata()?;
+        self.files
+            .push((path, (info.dev(), info.ino()), libc::S_IFREG as u32));
+        self.record = Some(file);
+        let file = self.record.as_mut().unwrap();
+        file.write_all(&data)?;
+        file.sync_all()?;
+        self._directory_guard.sync_all()?;
+        self.verify()
+    }
+}
+impl Drop for NativeRuntimeRegistration {
+    fn drop(&mut self) {
+        if self.verify().is_err() {
+            return;
+        }
+        for (path, id, kind) in &self.files {
+            if let Ok(info) = std::fs::symlink_metadata(path)
+                && (info.dev(), info.ino()) == *id
+                && info.mode() & libc::S_IFMT as u32 == *kind
+                && info.uid() == unsafe { libc::geteuid() }
+            {
+                let _ = std::fs::remove_file(path);
+            }
+        }
+        // Never traverse or delete unexpected files, nor remove the shared root.
+        let _ = std::fs::remove_dir(&self.directory);
+    }
+}
+
