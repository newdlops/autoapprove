+        let current = std::fs::metadata(f.home.join(POLICY_DIRECTORY))?;
+        assert_eq!(
+            (original.dev(), original.ino()),
+            (current.dev(), current.ino())
+        );
+        assert!(check_writer(&f.home, &change.thread_ids[0]).is_err());
+        Ok(())
+    }
