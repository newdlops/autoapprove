+                    reason: None,
+                    grant_root: None,
+                },
+            });
+            requests.resolve_notification("child", &AppServerRequestId::Integer(n));
+        }
+        let op = |id: &str| AppCommand::PatchApproval {
+            id: id.into(),
+            decision: FileChangeApprovalDecision::Accept,
+        };
+        assert!(!requests.was_resolved("child", &op("0")));
+        assert!(requests.was_resolved("child", &op("256")));
+        assert!(!requests.was_resolved("other", &op("256")));
+        assert!(!requests.was_resolved("child", &op("unknown")));
+        requests.clear();
+        assert!(!requests.was_resolved("child", &op("256")));
+    }
+}
