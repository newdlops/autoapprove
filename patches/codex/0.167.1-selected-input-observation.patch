+//! Policy storage only. The native caller must independently verify its live
+//! admission lease, journal, complete scope, writer closure and imported data.
+use super::*;
+use std::collections::BTreeMap;
+use std::io::Write;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Transition {
+    Incoming,
+    Retire,
+    Activate,
+}
+pub struct Request {
+    pub expected_revision: u64,
+    pub request_id: String,
+    pub thread_ids: Vec<String>,
+    pub transition: Transition,
+    pub destination_home_identity: Option<String>,
+}
+#[derive(Debug, PartialEq, Eq)]
+pub struct Receipt {
+    pub home_identity: String,
+    pub revision: u64,
+    pub request_id: String,
+    pub thread_ids: Vec<String>,
+    pub phase: &'static str,
+}
+pub fn revision(home: &Path) -> io::Result<u64> {
+    Ok(load(home)?.map_or(0, |loaded| loaded.state.revision))
+}
+fn conflict() -> io::Error {
+    io::Error::new(
+        io::ErrorKind::AlreadyExists,
+        "Conversation ownership changed; inspect the current move instead of replaying it",
+    )
+}
+struct PolicyLock {
+    home: std::path::PathBuf,
+    root: File,
+    directory: File,
+    lock: File,
+}
+impl PolicyLock {
+    fn acquire(home: &Path) -> io::Result<(Self, String)> {
+        let (home, root, identity) = open_home(home)?;
+        if unsafe { libc::mkdirat(root.as_raw_fd(), c".autoapprove-migrations".as_ptr(), 0o700) }
+            != 0
+            && io::Error::last_os_error().kind() != io::ErrorKind::AlreadyExists
+        {
+            return Err(unavailable());
+        }
+        let directory = open_at(
+            &root,
+            ".autoapprove-migrations",
+            libc::O_RDONLY | libc::O_DIRECTORY,
+            0,
+        )?;
+        if !private(&directory.metadata()?, true) {
+            return Err(unavailable());
+        }
+        let lock = open_at(
+            &directory,
+            "ownership-lock",
+            libc::O_RDWR | libc::O_CREAT,
+            0o600,
+        )?;
+        if !private(&lock.metadata()?, false) {
+            return Err(unavailable());
+        }
+        if unsafe { libc::flock(lock.as_raw_fd(), libc::LOCK_EX | libc::LOCK_NB) } != 0 {
+            return Err(io::Error::new(
+                io::ErrorKind::WouldBlock,
+                "Ownership update is already in progress",
+            ));
+        }
+        let result = Self {
+            home,
+            root,
+            directory,
+            lock,
+        };
+        result.verify()?;
+        Ok((result, identity))
+    }
+    fn verify(&self) -> io::Result<()> {
+        let root = self.root.metadata()?;
+        let current = std::fs::symlink_metadata(&self.home)?;
+        if !current.is_dir() || (root.dev(), root.ino()) != (current.dev(), current.ino()) {
+            return Err(unavailable());
+        }
+        let actual = open_at(
+            &self.root,
+            ".autoapprove-migrations",
+            libc::O_RDONLY | libc::O_DIRECTORY,
+            0,
+        )?;
+        let current = actual.metadata()?;
+        let pinned = self.directory.metadata()?;
+        if !private(&current, true)
+            || (current.dev(), current.ino()) != (pinned.dev(), pinned.ino())
+        {
+            return Err(unavailable());
+        }
+        let actual = open_at(&actual, "ownership-lock", libc::O_RDONLY, 0)?;
+        let current = actual.metadata()?;
+        let pinned = self.lock.metadata()?;
+        if !private(&current, false)
+            || (current.dev(), current.ino()) != (pinned.dev(), pinned.ino())
+        {
+            return Err(unavailable());
+        }
+        Ok(())
+    }
+}
+struct Temporary<'a> {
+    parent: &'a File,
+    name: String,
+    directory: bool,
+    published: bool,
+    entry: Option<File>,
+    children: Vec<(&'static str, File)>,
+}
+impl Drop for Temporary<'_> {
+    fn drop(&mut self) {
+        if self.published {
+            return;
+        }
+        let Some(pinned) = &self.entry else {
+            return;
+        };
+        let Ok(current) = open_at(
+            self.parent,
+            &self.name,
+            libc::O_RDONLY | if self.directory { libc::O_DIRECTORY } else { 0 },
+            0,
+        ) else {
+            return;
+        };
+        let (Ok(a), Ok(b)) = (pinned.metadata(), current.metadata()) else {
+            return;
+        };
+        if (a.dev(), a.ino()) != (b.dev(), b.ino()) {
+            return;
+        }
+        let Ok(name) = std::ffi::CString::new(self.name.as_str()) else {
+            return;
+        };
+        if self.directory {
+            if let Ok(dir) = open_at(
+                self.parent,
+                &self.name,
+                libc::O_RDONLY | libc::O_DIRECTORY,
+                0,
+            ) {
+                for (name, pinned) in &self.children {
+                    let Ok(current) = open_at(&dir, name, libc::O_RDONLY, 0) else {
+                        continue;
+                    };
+                    let (Ok(a), Ok(b)) = (pinned.metadata(), current.metadata()) else {
+                        continue;
+                    };
+                    if (a.dev(), a.ino()) != (b.dev(), b.ino()) {
+                        continue;
+                    }
+                    let Ok(name) = std::ffi::CString::new(*name) else {
+                        continue;
+                    };
+                    unsafe {
+                        libc::unlinkat(dir.as_raw_fd(), name.as_ptr(), 0);
+                    }
+                }
+            }
+        }
+        unsafe {
+            libc::unlinkat(
+                self.parent.as_raw_fd(),
+                name.as_ptr(),
+                if self.directory {
+                    libc::AT_REMOVEDIR
+                } else {
+                    0
+                },
+            );
+        }
+    }
+}
+fn write_new(parent: &File, name: &str, data: &[u8]) -> io::Result<File> {
+    let mut file = open_at(
+        parent,
+        name,
+        libc::O_WRONLY | libc::O_CREAT | libc::O_EXCL,
+        0o600,
+    )?;
+    if !private(&file.metadata()?, false) {
+        return Err(unavailable());
+    }
+    file.write_all(data)?;
+    file.sync_all()?;
+    Ok(file)
+}
+fn same_current(home: &Path, before: Option<&Loaded>) -> io::Result<()> {
+    if let Some(before) = before {
+        before.verify()?;
+        let current = load(home)?.ok_or_else(conflict)?;
+        let a = before.policy.metadata()?;
+        let b = current.policy.metadata()?;
+        if before.state != current.state || (a.dev(), a.ino()) != (b.dev(), b.ino()) {
+            return Err(conflict());
+        }
+    } else if present(&home.join(POLICY_DIRECTORY))? {
+        return Err(conflict());
+    }
+    Ok(())
+}
+fn rename_new_directory(root: &File, from: &str) -> io::Result<()> {
+    let from = std::ffi::CString::new(from).map_err(|_| unavailable())?;
+    let result;
+    #[cfg(target_os = "macos")]
+    {
+        result = unsafe {
+            libc::renameatx_np(
+                root.as_raw_fd(),
+                from.as_ptr(),
+                root.as_raw_fd(),
+                c".autoapprove-ownership".as_ptr(),
+                libc::RENAME_EXCL,
+            )
+        };
+    }
+    #[cfg(target_os = "linux")]
+    {
+        result = unsafe {
+            libc::renameat2(
+                root.as_raw_fd(),
+                from.as_ptr(),
+                root.as_raw_fd(),
+                c".autoapprove-ownership".as_ptr(),
+                libc::RENAME_NOREPLACE,
+            )
+        };
+    }
+    #[cfg(not(any(target_os = "macos", target_os = "linux")))]
+    {
+        return Err(io::Error::new(
+            io::ErrorKind::Unsupported,
+            "Atomic policy installation is unavailable",
+        ));
+    }
+    if result == 0 { Ok(()) } else { Err(conflict()) }
+}
+
+/// Compare-and-swap storage; authorize must be read-only and revalidate native
+/// authority. Any error after publication is an unknown outcome to observe,
+/// never permission to replay the same operation.
+pub fn apply(
+    home: &Path,
+    request: &Request,
+    mut authorize: impl FnMut() -> io::Result<()>,
+) -> io::Result<Receipt> {
+    if !canonical_uuid(&request.request_id)
+        || request.thread_ids.is_empty()
+        || request.thread_ids.len() > 512
+        || request.thread_ids.iter().any(|id| !canonical_uuid(id))
+    {
+        return Err(unavailable());
+    }
+    let ids: HashSet<_> = request.thread_ids.iter().cloned().collect();
+    if ids.len() != request.thread_ids.len() {
+        return Err(unavailable());
+    }
+    let (lock, home_identity) = PolicyLock::acquire(home)?;
+    let before = load(home)?;
+    let mut state = before
+        .as_ref()
+        .map(|value| value.state.clone())
+        .unwrap_or_else(|| State {
+            schema_version: 1,
+            home_identity: home_identity.clone(),
+            revision: 0,
+            threads: vec![],
+        });
+    if state.revision != request.expected_revision {
+        return Err(conflict());
+    }
+    let (phase, owner) = match request.transition {
+        Transition::Retire => {
+            let owner = request
+                .destination_home_identity
+                .as_ref()
+                .ok_or_else(unavailable)?;
+            if !identity(owner) || owner == &home_identity {
+                return Err(unavailable());
+            }
+            (Phase::Retired, owner.clone())
+        }
+        Transition::Incoming | Transition::Activate => {
+            if request.destination_home_identity.is_some() {
+                return Err(unavailable());
+            }
+            (
+                if request.transition == Transition::Incoming {
+                    Phase::Incoming
+                } else {
+                    Phase::Active
+                },
+                home_identity.clone(),
+            )
+        }
+    };
+    let current_request: HashSet<_> = state
+        .threads
+        .iter()
+        .filter(|row| row.request_id == request.request_id)
+        .map(|row| row.thread_id.clone())
+        .collect();
+    if request.transition == Transition::Activate {
+        if current_request != ids {
+            return Err(conflict());
+        }
+    } else if !current_request.is_empty() {
+        return Err(conflict());
+    }
+    let mut rows: BTreeMap<_, _> = state
+        .threads
+        .into_iter()
+        .map(|row| (row.thread_id.clone(), row))
+        .collect();
+    for id in &ids {
+        let old = rows.get(id);
+        let valid = match request.transition {
+            Transition::Incoming => old.is_none_or(|row| row.phase == Phase::Retired),
+            Transition::Retire => old.is_none_or(|row| row.phase == Phase::Active),
+            Transition::Activate => old.is_some_and(|row| {
+                row.phase == Phase::Incoming && row.request_id == request.request_id
+            }),
+        };
+        if !valid {
+            return Err(conflict());
+        }
+        rows.insert(
+            id.clone(),
+            Thread {
+                thread_id: id.clone(),
+                request_id: request.request_id.clone(),
+                owner_home_identity: owner.clone(),
+                phase: phase.clone(),
+            },
+        );
+    }
+    state.threads = rows.into_values().collect();
+    state.revision = state.revision.checked_add(1).ok_or_else(unavailable)?;
+    let bytes = serde_json::to_vec(&state)?;
+    if state.threads.len() > 65_536 || bytes.len() > 16 * 1024 * 1024 {
+        return Err(unavailable());
+    }
+    authorize()?;
+    if let Some(before) = &before {
+        let mut temporary = Temporary {
+            parent: &before.policy,
+            name: format!(".state-{}", uuid::Uuid::new_v4()),
+            directory: false,
+            published: false,
+            entry: None,
+            children: vec![],
+        };
+        temporary.entry = Some(write_new(&before.policy, &temporary.name, &bytes)?);
+        authorize()?;
+        lock.verify()?;
+        same_current(home, Some(before))?;
+        let from = std::ffi::CString::new(temporary.name.as_str()).map_err(|_| unavailable())?;
+        if unsafe {
+            libc::renameat(
+                before.policy.as_raw_fd(),
+                from.as_ptr(),
+                before.policy.as_raw_fd(),
+                c"state.json".as_ptr(),
+            )
+        } != 0
+        {
+            return Err(unavailable());
+        }
+        temporary.published = true;
+        before.policy.sync_all()?;
+    } else {
+        let mut temporary = Temporary {
+            parent: &lock.root,
+            name: format!(".autoapprove-ownership-stage-{}", uuid::Uuid::new_v4()),
+            directory: true,
+            published: false,
+            entry: None,
+            children: vec![],
+        };
+        let name = std::ffi::CString::new(temporary.name.as_str()).map_err(|_| unavailable())?;
+        if unsafe { libc::mkdirat(lock.root.as_raw_fd(), name.as_ptr(), 0o700) } != 0 {
+            return Err(unavailable());
+        }
+        let directory = open_at(
+            &lock.root,
+            &temporary.name,
+            libc::O_RDONLY | libc::O_DIRECTORY,
+            0,
+        )?;
+        temporary.entry = Some(directory.try_clone()?);
+        temporary.children.push((
+            REQUIRED_FILE,
+            write_new(
+                &directory,
+                REQUIRED_FILE,
+                &serde_json::to_vec(&Required {
+                    schema_version: 1,
+                    home_identity: home_identity.clone(),
+                })?,
+            )?,
+        ));
+        temporary
+            .children
+            .push((STATE_FILE, write_new(&directory, STATE_FILE, &bytes)?));
+        directory.sync_all()?;
+        authorize()?;
+        lock.verify()?;
+        same_current(home, before.as_ref())?;
+        rename_new_directory(&lock.root, &temporary.name)?;
+        temporary.published = true;
+        lock.root.sync_all()?;
+    }
+    let mut thread_ids: Vec<_> = ids.into_iter().collect();
+    thread_ids.sort();
+    Ok(Receipt {
+        home_identity,
+        revision: state.revision,
+        request_id: request.request_id.clone(),
+        thread_ids,
+        phase: match phase {
+            Phase::Incoming => "incoming",
+            Phase::Retired => "retired",
+            Phase::Active => "active",
+        },
+    })
+}
