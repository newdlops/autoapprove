+impl Drop for SelectedAdmissionPermit {
+    fn drop(&mut self) {
+        let mut state = self
+            .admission
+            .state
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        if let Some(id) = self.thread {
+            let counts = if self.input {
+                &mut state.selected_inputs
+            } else {
+                &mut state.selected_active
+            };
+            let count = counts.get_mut(&id).expect("owned admission permit");
+            *count -= 1;
+            if *count == 0 {
+                counts.remove(&id);
+            }
+        } else {
+            state.unscoped_active -= 1;
+        }
+        self.admission
+            .selected_revision_tx
+            .send_modify(|revision| *revision = revision.wrapping_add(1));
+    }
