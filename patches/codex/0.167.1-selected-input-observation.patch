+        std::fs::set_permissions(&state, std::fs::Permissions::from_mode(0o644))?;
+        assert!(check_writer(&f.home, &f.thread).is_err());
+        std::fs::set_permissions(&state, std::fs::Permissions::from_mode(0o600))?;
+        let saved = f.home.join("saved");
+        std::fs::rename(&state, &saved)?;
+        assert!(check_writer(&f.home, &f.thread).is_err());
+        symlink(&saved, &state)?;
+        assert!(check_writer(&f.home, &f.thread).is_err());
+        std::fs::remove_file(&state)?;
+        std::fs::hard_link(&saved, &state)?;
+        assert!(check_writer(&f.home, &f.thread).is_err());
+        std::fs::remove_file(&state)?;
+        let replacement = f._root.path().join("replacement");
+        std::fs::create_dir(&replacement)?;
+        std::fs::create_dir(replacement.join(POLICY_DIRECTORY))?;
+        std::fs::set_permissions(
+            replacement.join(POLICY_DIRECTORY),
+            std::fs::Permissions::from_mode(0o700),
+        )?;
+        for file in [STATE_FILE, REQUIRED_FILE] {
+            let from = if file == STATE_FILE {
+                saved.clone()
+            } else {
+                f.policy().join(file)
+            };
+            std::fs::copy(from, replacement.join(POLICY_DIRECTORY).join(file))?;
+        }
+        assert!(check_writer(&replacement, &f.thread).is_err());
+        Ok(())
+    }
+}
