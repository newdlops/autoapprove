+            *state.selected_active.entry(id).or_default() += 1;
+        } else {
+            state.unscoped_active += 1;
+        }
+        Ok(SelectedAdmissionPermit {
+            admission: self.clone(),
+            thread,
+            input: false,
+        })
+    }
