+    /// Close input admission only for the exact selected cohort. This is not
+    /// proof of idle work, complete membership, client quiescence or migration.
+    /// The caller must establish those separately while retaining this guard.
+    pub(crate) async fn pause_selected(
+        &self,
+        threads: HashSet<ThreadId>,
+    ) -> Result<SelectedAdmissionPause, JSONRPCErrorError> {
+        if threads.is_empty() || threads.len() > 512 {
+            return Err(invalid_request("Select between 1 and 512 conversations"));
+        }
+        let mut revision = self.selected_revision_tx.subscribe();
+        {
+            let mut state = self
+                .state
+                .lock()
+                .unwrap_or_else(std::sync::PoisonError::into_inner);
+            if state.closed || state.paused || state.selected.is_some() {
+                return Err(invalid_request(
+                    "Conversation transition is already in progress",
+                ));
+            }
+            state.selected = Some(threads);
+            state.selected_inputs_closed = false;
+        }
+        // Construct before any await: cancellation and timeout reopen admission.
+        let pause = SelectedAdmissionPause(self.clone());
+        tokio::time::timeout(std::time::Duration::from_secs(10), async {
+            loop {
+                {
+                    let mut state = self
+                        .state
+                        .lock()
+                        .unwrap_or_else(std::sync::PoisonError::into_inner);
+                    if state.closed {
+                        return Err(invalid_request(
+                            "Server began shutdown during conversation transition",
+                        ));
+                    }
+                    let selected = state
+                        .selected
+                        .as_ref()
+                        .expect("owned selected admission guard");
