+#[tokio::test]
+async fn autoapprove_resolved_child_overlay_and_queued_click_are_cleared() -> Result<()> {
+    let (mut app, mut events, _ops) = make_test_app_with_channels().await;
+    let app_server = crate::start_embedded_app_server_for_picker(&app.config).await?;
+    let parent = ThreadId::new();
+    let child = ThreadId::new();
+    let sibling = ThreadId::new();
+    app.enqueue_primary_thread_session(
+        test_thread_session(parent, test_path_buf("/tmp/project")),
+        Vec::new(),
+    )
+    .await?;
+    while events.try_recv().is_ok() {}
+    for (thread, rpc) in [(child, 101), (sibling, 102)] {
+        let mut request = exec_approval_request(thread, "turn", "same-item", None);
+        let ServerRequest::CommandExecutionRequestApproval { request_id, .. } = &mut request else {
+            unreachable!()
+        };
+        *request_id = AppServerRequestId::Integer(rpc);
+        app.pending_app_server_requests
+            .note_server_request(&request);
+        app.enqueue_thread_request(thread, request).await?;
+    }
+    assert_eq!(app.chat_widget.thread_id(), Some(parent));
+    assert!(app.chat_widget.has_active_view());
+    app.handle_app_server_event(
+        &app_server,
+        codex_app_server_client::AppServerEvent::ServerNotification(Box::new(
+            ServerNotification::ServerRequestResolved(
+                codex_app_server_protocol::ServerRequestResolvedNotification {
+                    thread_id: child.to_string(),
+                    request_id: AppServerRequestId::Integer(101),
+                },
+            ),
+        )),
+    )
+    .await;
+    // Only the sibling remains actionable even though its item ID is identical.
+    assert!(app.chat_widget.has_active_view());
+    app.chat_widget
+        .handle_key_event(KeyEvent::new(KeyCode::Char('y'), KeyModifiers::NONE));
+    let target = std::iter::from_fn(|| events.try_recv().ok()).find_map(|event| match event {
+        AppEvent::SubmitThreadOp { thread_id, .. } => Some(thread_id),
+        _ => None,
+    });
+    assert_eq!(target, Some(sibling));
+    assert!(!app.chat_widget.has_active_view());
+    let stale_click = crate::app_command::AppCommand::ExecApproval {
+        id: "same-item".into(),
+        turn_id: None,
+        decision: codex_app_server_protocol::CommandExecutionApprovalDecision::Accept,
+    };
+    assert!(
+        app.try_resolve_app_server_request(child, &stale_click)
+            .await?
+    );
+    assert!(
+        !app.try_resolve_app_server_request(ThreadId::new(), &stale_click)
+            .await?
+    );
+    app_server.shutdown().await?;
+    Ok(())
+}
