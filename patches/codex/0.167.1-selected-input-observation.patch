+//! Local diagnostic observation, never a census-completeness or migration grant.
+use crate::message_processor::MessageProcessor;
+use crate::transport::ConnectionId;
+use crate::transport::ConnectionState;
+use serde_json::Value;
+use serde_json::json;
+use std::collections::HashMap;
+use std::io;
+use std::time::Duration;
+use tokio::sync::mpsc;
+use tokio::sync::oneshot;
+
+pub(crate) struct InventoryRead {
+    pub(crate) nonce: String,
+    pub(crate) reply: oneshot::Sender<Value>,
+}
+
+#[cfg(all(feature = "autoapprove-native-inventory", unix))]
+#[path = "native_inventory_transport.rs"]
+mod transport;
+#[cfg(all(feature = "autoapprove-native-inventory", unix))]
+pub(crate) use transport::InventoryServer;
+#[cfg(not(all(feature = "autoapprove-native-inventory", unix)))]
+pub(crate) struct InventoryServer;
+
+pub(crate) fn start(events: mpsc::Sender<InventoryRead>) -> io::Result<Option<InventoryServer>> {
+    #[cfg(all(feature = "autoapprove-native-inventory", unix))]
+    {
+        transport::start(events)
+    }
+    #[cfg(not(all(feature = "autoapprove-native-inventory", unix)))]
+    {
+        drop(events);
+        Ok(None)
+    }
+}
+
+fn connection_rows(connections: &HashMap<ConnectionId, ConnectionState>) -> Vec<Value> {
+    let mut rows: Vec<_> = connections.iter().collect();
+    rows.sort_by_key(|(id, _)| id.0);
+    rows.into_iter()
+        .map(|(id, connection)| {
+            json!({
+                "connectionID":id.0,
+                "origin":format!("{:?}",connection.origin),
+                "initialized":connection.session.initialized(),
+                "untrustedClientName":connection.session.app_server_client_name(),
+                "untrustedClientVersion":connection.session.client_version(),
+                "nativePeerIdentified":connection.native_peer.is_some(),
+                "nativePeer":connection.native_peer,
+                "nativeConnectionNonce":connection.native_connection_nonce,
+                "clientInventoryBound":false
+            })
+        })
+        .collect()
+}
+
+pub(crate) async fn snapshot(
+    nonce: String,
+    generation: &str,
+    connections: &HashMap<ConnectionId, ConnectionState>,
+    processor: &MessageProcessor,
+) -> Value {
+    // Keep a diagnostic from holding the transport loop behind a contended
+    // subscription lock. Neither the two stores nor pending transport events
+    // are revision-bound yet, so this must never authorize effects.
+    let subscriptions = tokio::time::timeout(
+        Duration::from_millis(100),
+        processor.native_inventory_subscriptions(),
+    )
+    .await;
+    let (subscriptions, error) = match subscriptions {
+        Ok(value) => (value, None),
+        Err(_) => (Value::Null, Some("subscription-snapshot-timeout")),
+    };
+    json!({
+        "schemaVersion":1,
+        "producer":"autoapprove-native-server-prototype",
+        "upstreamCommit":"0a94398fa60c4fac0e7659e4213a0a36e613dd46",
+        "cliVersion":env!("CARGO_PKG_VERSION"),
+        "pid":std::process::id(),
+        "serverGeneration":generation,
+        "nonce":nonce,
+        "connections":connection_rows(connections),
+        "subscriptions":subscriptions,
+        "error":error,
+        "consistentRevision":false,
+        "membershipComplete":false,
+        "admissionGranted":false,
+        "limitations":[
+            "native-peer-to-client-inventory-binding-required",
+            "client-inventory-binding-required",
+            "pending-transport-and-subscriber-revision-required",
+            "native-admission-and-backend-attestation-required"
+        ]
+    })
+}
+
